<%- include('../_header') %>
<div class="card tools">
  <p class="tools-back no-print"><a href="/tools/templates">← Шаблоны</a></p>
  <h1><%= tpl.title %></h1>
  <% if (tpl.review) { %><p class="notice-honest" role="note"><%= review %></p><% } %>
  <form method="POST" action="/tools/templates/<%= tpl.id %>/export" class="tools-form">
    <h2>Подстановка</h2>
    <% if (!fields.length) { %><p class="hint">В шаблоне нет мест для подстановки.</p><% } %>
    <% fields.forEach(function(f) { %>
      <label for="<%= f.name %>"><%= f.key %></label>
      <input id="<%= f.name %>" type="text" name="<%= f.name %>" value="<%= f.value %>" maxlength="300" />
    <% }) %>
    <% if (fields.some(function(f) { return f.key === '[ФИО]'; })) { %>
      <label for="pt">Подставить ФИО выбранного пациента в [ФИО] (если поле выше пустое; по желанию)</label>
      <select id="pt" name="patient_id"><option value="">— не подставлять —</option>
        <% patients.forEach(function(p) { %><option value="<%= p.id %>"><%= p.full_name %></option><% }) %>
      </select>
    <% } %>
    <h2>Текст шаблона</h2>
    <pre class="tools-pre"><%= tpl.body %></pre>
    <p class="no-print">
      <button type="submit" name="fmt" value="docx">Скачать DOCX</button>
      <button type="submit" name="fmt" value="pdf">Скачать PDF</button>
      <button type="submit" name="fmt" value="txt">Скачать TXT</button>
      <button type="submit" name="fmt" value="print" class="btn-secondary">Открыть для печати</button>
    </p>
    <p class="hint">Незаполненные места остаются в тексте в скобках. Имя файла не содержит ФИО.
      <% if (!tpl.own) { %><a href="/tools/templates/<%= tpl.id %>/edit">Копировать в мои и править</a><% } else { %><a href="/tools/templates/<%= tpl.id %>/edit">Править шаблон</a><% } %></p>
  </form>
</div>
<%- include('../_footer') %>
