<%- include('../_header') %>
<div class="card tools">
  <h1>Инструменты</h1>
  <p class="hint">Всё здесь необязательно и работает отдельно от вашей МИС: ничего не нужно заполнять заранее. Тексты шаблонов и пороги — демонстрационные заглушки, ожидают клинического ревью.</p>
  <ul class="tools-grid">
    <% sections.forEach(function(s) { %>
      <li><a class="tools-tile" href="<%= s.href %>"><strong><%= s.label %></strong><span><%= s.hint %></span></a></li>
    <% }) %>
  </ul>
</div>
<%- include('../_footer') %>
