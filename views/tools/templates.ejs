<%- include('../_header') %>
<div class="card tools">
  <%- include('_back') %>
  <h1>Шаблоны документов</h1>
  <p class="notice-honest"><%= review %> Подстановка данных пациента — только вручную или по вашему явному выбору.</p>
  <p><a class="btn-link" href="/tools/templates/new">Создать свой шаблон</a></p>
  <h2>Встроенные (заглушки)</h2>
  <ul class="tools-list">
    <% list.builtin.forEach(function(t) { %>
      <li><a href="/tools/templates/<%= t.id %>"><%= t.title %></a> <span class="badge badge-muted">заглушка, ревью</span></li>
    <% }) %>
  </ul>
  <h2>Мои шаблоны</h2>
  <% if (!list.own.length) { %>
    <div class="empty-state"><p class="empty-state__title">Своих шаблонов пока нет</p><p>Необязательно. Можно создать с нуля или сделать копию встроенного: откройте его и нажмите «Копировать в мои».</p></div>
  <% } else { %>
    <ul class="tools-list">
      <% list.own.forEach(function(t) { %>
        <li><a href="/tools/templates/<%= t.id %>"><%= t.title %></a> · <a href="/tools/templates/<%= t.id %>/edit">править</a> · <a href="/tools/templates/<%= t.id %>/delete">удалить</a></li>
      <% }) %>
    </ul>
  <% } %>
  <h2>Библиотека: клинические рекомендации</h2>
  <div class="empty-state"><p class="empty-state__title">Список ссылок пока не передан</p><p>Ссылки и названия клинических рекомендаций предоставит владелец или исследовательский блок; тексты рекомендаций в сервис не копируются. Необязательно.</p></div>
</div>
<%- include('../_footer') %>
