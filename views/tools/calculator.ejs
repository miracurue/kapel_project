<%- include('../_header') %>
<div class="card tools">
  <p class="tools-back no-print"><a href="/tools/calculator">← Все шкалы</a></p>
  <h1><%= scale.title %></h1>
  <p class="notice-honest"><strong>Ничего не сохраняется.</strong> Ответы и результат остаются только на этой странице.</p>
  <% if (scale.stub) { %><p class="notice-honest" role="note"><strong>Заглушка.</strong> <%= scale.note %></p><% } %>
  <% if (error) { %><div class="flash flash-error" role="alert"><span class="flash__icon" aria-hidden="true">!</span><span><%= error %></span></div><% } %>

  <% if (computed) { var r = computed.result; %>
    <section class="tools-result" aria-labelledby="res-h">
      <h2 id="res-h">Результат</h2>
      <p class="tools-result__num"><span class="tools-result__total"><%= r.total %></span>
        <% if (r.subscales && scale.code === 'hads') { %> (тревога <%= r.subscales.A %>, депрессия <%= r.subscales.D %>)<% } %></p>
      <p><strong>Уровень:</strong> <%= r.band %></p>
      <% if (r.riskReasons.length) { %>
        <div class="flash flash-error" role="alert"><span class="flash__icon" aria-hidden="true">!</span><div>
          <strong>Внимание врачу: сработали правила шкалы.</strong>
          <ul><% r.riskReasons.forEach(function(x) { %><li><%= x %></li><% }) %></ul>
          <p><%= r.noEscalation %></p>
        </div></div>
      <% } else if (r.critical) { %>
        <div class="flash flash-error" role="alert"><span class="flash__icon" aria-hidden="true">!</span><span>Отмечен критический пункт. <%= r.noEscalation %></span></div>
      <% } %>
      <p class="result-disclaimer"><%= r.scope %></p>
      <textarea id="calc-text" class="pc-copy-area" rows="6" readonly aria-label="Текст результата для копирования"><%= computed.text %></textarea>
      <p class="no-print"><button type="button" id="calc-copy" class="btn-secondary" hidden>Копировать результат</button> <span id="calc-copy-status" class="hint" role="status"></span></p>

      <% if (saveAllowed) { %>
      <details class="no-print tools-save">
        <summary>Сохранить итог в карточку пациента (по желанию)</summary>
        <form method="POST" action="/tools/calculator/<%= scale.code %>/save" class="filter-bar">
          <% answers.forEach(function(a, i) { %><input type="hidden" name="a<%= i %>" value="<%= a %>" /><% }) %>
          <label>Пациент
            <select name="patient_id"><option value="">— выберите —</option>
              <% patients.forEach(function(p) { %><option value="<%= p.id %>"><%= p.full_name %></option><% }) %>
            </select></label>
          <label>Дата теста <input type="date" name="test_date" value="<%= today %>" /></label>
          <button type="submit">Сохранить итог</button>
        </form>
        <p class="hint">Сохраняется только итог (как при ручном вводе очного бланка); ответы по пунктам не сохраняются. Эскалация не создаётся автоматически — как и при ручном вводе.<% if (scale.stub) { %> Для заглушки сохраняется протокол с баллом.<% } %></p>
      </details>
      <% } else { %>
        <p class="hint">C-SSRS в карточку из калькулятора не сохраняется: скринер проводится с пациентом и подчиняется кризисному протоколу.</p>
      <% } %>
    </section>
  <% } %>

  <form method="POST" action="/tools/calculator/<%= scale.code %>" class="tools-form">
    <h2><%= computed ? 'Изменить ответы' : 'Ответы' %></h2>
    <% scale.items.forEach(function(it, i) { %>
      <fieldset class="tools-item">
        <legend><%= i + 1 %>. <%= it.text %><% if (scale.criticalItemIndex === i) { %> <span class="badge badge-risk">критический пункт</span><% } %></legend>
        <div class="tools-opts">
          <% scale.options.forEach(function(o) { %>
            <label class="tools-opt"><input type="radio" name="a<%= i %>" value="<%= o.value %>"<%= answers[i] === o.value ? ' checked' : '' %> /> <span><%= o.label %> <small>(<%= o.value %>)</small></span></label>
          <% }) %>
        </div>
      </fieldset>
    <% }) %>
    <p><button type="submit">Подсчитать</button> <a href="/tools/calculator">Отмена</a></p>
  </form>
</div>
<script src="/tools.js" defer></script>
<%- include('../_footer') %>
