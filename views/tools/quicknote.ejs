<%- include('../_header') %>
<div class="card tools">
  <%- include('_back') %>
  <h1>Быстрая заметка</h1>
  <p class="notice-honest">Вставьте свободный текст — он будет разложен по разделам локальным шаблоном (по меткам «Жалобы:», «План:» и ключевым словам). Это не ИИ-модель и не интерпретация: ничего не добавляется. Результат — ЧЕРНОВИК. Необязательно; без вашего решения ничего не сохраняется.</p>
  <form method="POST" action="/tools/quicknote" class="tools-form">
    <label for="qn-text">Текст заметки</label>
    <textarea id="qn-text" name="text" rows="8" maxlength="8000"><%= text %></textarea>
    <p><button type="submit">Структурировать в черновик</button></p>
  </form>
  <% if (result) { %>
    <section aria-labelledby="qn-h">
      <h2 id="qn-h">Черновик</h2>
      <p class="badge badge-muted"><%= result.label %></p>
      <% if (result.empty) { %>
        <div class="empty-state"><p class="empty-state__title">Нечего разложить</p><p>Вставьте текст заметки выше.</p></div>
      <% } else { %>
        <textarea id="qn-draft" class="pc-copy-area" rows="12" readonly aria-label="Черновик для копирования"><%= result.draft %></textarea>
        <p class="no-print"><button type="button" id="qn-copy" class="btn-secondary" hidden>Копировать</button> <span id="qn-copy-status" class="hint" role="status"></span></p>
        <form method="POST" action="/tools/quicknote/save" class="filter-bar no-print">
          <input type="hidden" name="draft" value="<%= result.draft %>" />
          <label>Сохранить в заметки пациента
            <select name="patient_id"><option value="">— выберите —</option>
              <% patients.forEach(function(p) { %><option value="<%= p.id %>"><%= p.full_name %></option><% }) %>
            </select></label>
          <button type="submit" class="btn-secondary">Сохранить как черновик заметки</button>
        </form>
      <% } %>
    </section>
  <% } %>
</div>
<script src="/tools.js" defer></script>
<%- include('../_footer') %>
