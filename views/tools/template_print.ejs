<%- include('../_header') %>
<div class="card tools print-doc">
  <p class="tools-back no-print"><a href="/tools/templates">← Шаблоны</a></p>
  <p class="print-only print-banner">Демо · <%= doc.draftLabel %></p>
  <h1><%= doc.title %></h1>
  <p class="badge badge-muted"><%= doc.draftLabel %></p>
  <pre class="tools-pre tools-pre--doc"><%= text %></pre>
  <p class="result-disclaimer"><%= doc.disclaimer %></p>
  <p class="no-print"><button type="button" id="tools-print" class="btn-secondary" hidden>Печать</button></p>
</div>
<script src="/tools.js" defer></script>
<%- include('../_footer') %>
