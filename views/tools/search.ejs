<%- include('../_header') %>
<div class="card tools">
  <%- include('_back') %>
  <h1>Поиск</h1>
  <p class="hint">По вашим заметкам, материалам и диалогам ИИ-пространства и шаблонам. Чужие записи не ищутся.</p>
  <form method="GET" action="/tools/search" class="filter-bar" role="search">
    <label>Что искать <input type="search" name="q" value="<%= q %>" maxlength="100" /></label>
    <button type="submit">Найти</button>
  </form>
  <% if (q && r.q.length < 2) { %>
    <p class="hint">Введите не менее двух символов.</p>
  <% } else if (q && r.total === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Ничего не найдено</p><p>Попробуйте другое слово.</p></div>
  <% } else if (q) { %>
    <% if (r.notes.length) { %><h2>Заметки (<%= r.notes.length %>)</h2><ul class="tools-list"><% r.notes.forEach(function(n) { %><li><a href="/patients/<%= n.patientId %>/notes"><%= n.patient %></a>, <%= formatDate(n.date) %>: <%= n.text %></li><% }) %></ul><% } %>
    <% if (r.materials.length) { %><h2>Материалы (<%= r.materials.length %>)</h2><ul class="tools-list"><% r.materials.forEach(function(m) { %><li><a href="/ai/t/<%= m.threadId %>"><%= m.name %></a>: <%= m.text %></li><% }) %></ul><% } %>
    <% if (r.threads.length) { %><h2>Диалоги ИИ-пространства (<%= r.threads.length %>)</h2><ul class="tools-list"><% r.threads.forEach(function(t) { %><li><a href="/ai/t/<%= t.id %>"><%= t.title %></a></li><% }) %></ul><% } %>
    <% if (r.templates.length) { %><h2>Шаблоны (<%= r.templates.length %>)</h2><ul class="tools-list"><% r.templates.forEach(function(t) { %><li><a href="/tools/templates/<%= t.id %>"><%= t.title %></a><%= t.own ? '' : ' (встроенный)' %>: <%= t.text %></li><% }) %></ul><% } %>
  <% } %>
</div>
<%- include('../_footer') %>
