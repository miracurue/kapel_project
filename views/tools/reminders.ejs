<%- include('../_header') %>
<div class="card tools">
  <%- include('_back') %>
  <h1>Пора повторить тест</h1>
  <p class="notice-honest">Мягкая подсказка, не обязательство: пациенты с давним последним результатом шкалы. Интервал — ваш выбор (по умолчанию значение-заглушка, ожидает клинического ревью). Уже назначенные тесты не показываются.</p>
  <form method="GET" action="/tools/reminders" class="filter-bar">
    <label>Прошло не менее
      <select name="days"><% choices.forEach(function(c) { %><option value="<%= c %>"<%= c === days ? ' selected' : '' %>><%= c %> дн.</option><% }) %></select></label>
    <button type="submit" class="btn-secondary">Показать</button>
  </form>
  <% if (!list.length) { %>
    <div class="empty-state"><p class="empty-state__title">Сейчас повторять нечего</p><p>Нет пациентов, у кого последний результат старше <%= days %> дн. Ничего делать не нужно.</p></div>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Пациент</th><th>Шкала: последний результат</th><th>Действия</th></tr></thead>
      <tbody>
      <% list.forEach(function(e) { %>
        <tr>
          <td><a href="/patients/<%= e.patient.id %>"><%= e.patient.full_name %></a></td>
          <td><% e.items.forEach(function(i) { %><div><%- instrumentTag(i.code) %> — <%= formatDate(i.lastDate) %> (<%= i.days %> дн. назад)</div><% }) %></td>
          <td class="row-actions">
            <a href="/patients/<%= e.patient.id %>">Карточка</a>
            <form method="POST" action="/tools/reminders/snooze" class="inline"><input type="hidden" name="patient_id" value="<%= e.patient.id %>" /><input type="hidden" name="days" value="<%= days %>" /><button type="submit" class="btn-secondary">Не напоминать <%= snoozeDays %> дн.</button></form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>
<%- include('../_footer') %>
