<%- include('../_header') %>
<div class="card tools">
  <p class="tools-back no-print"><a href="/tools/templates">← Шаблоны</a></p>
  <h1><%= tpl.id ? 'Правка шаблона' : 'Новый шаблон' %></h1>
  <% if (error) { %><div class="flash flash-error" role="alert"><span class="flash__icon" aria-hidden="true">!</span><span><%= error %></span></div><% } %>
  <form method="POST" action="<%= tpl.id ? '/tools/templates/' + tpl.id + '/update' : '/tools/templates' %>" class="tools-form">
    <label for="t-title">Название</label>
    <input id="t-title" type="text" name="title" maxlength="120" value="<%= tpl.title %>" />
    <label for="t-body">Текст</label>
    <textarea id="t-body" name="body" rows="14" maxlength="<%= max %>"><%= tpl.body %></textarea>
    <p class="hint">Места для подстановки пишите в квадратных скобках: [ФИО], [дата], [врач]. Любые другие [слова] тоже станут полями при выгрузке. Не вносите в шаблон данные конкретных пациентов.</p>
    <p><button type="submit">Сохранить</button> <a href="/tools/templates">Отмена</a></p>
  </form>
</div>
<%- include('../_footer') %>
