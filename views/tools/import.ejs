<%- include('../_header') %>
<div class="card tools">
  <%- include('_back') %>
  <h1>Импорт офлайн-результатов из CSV</h1>
  <p class="hint">Необязательно. Полезно, если результаты бланков уже лежат в таблице. Только ваши закреплённые пациенты; значения проверяются по диапазонам шкал; до подтверждения ничего не записывается.</p>
  <ol class="tools-steps">
    <li><a class="btn-link" href="/tools/import/template.csv">Скачать шаблон файла</a></li>
    <li>Заполните таблицу (ID пациента виден в адресе его карточки). Кодировки UTF-8 и Windows-1251 (Excel), разделители «;» и «,». Не более <%= limits.rows %> строк и <%= limits.mb %> МБ.</li>
    <li>Загрузите файл — откроется предпросмотр с ошибками по строкам.</li>
  </ol>
  <form method="POST" action="/tools/import/upload" enctype="multipart/form-data" class="tools-form">
    <label for="csv-file">Файл CSV</label>
    <input id="csv-file" type="file" name="file" accept=".csv,text/csv,text/plain" />
    <p><button type="submit">Загрузить и проверить</button></p>
  </form>
  <h2>Выполненные импорты</h2>
  <% if (!batches.length) { %>
    <div class="empty-state"><p class="empty-state__title">Импортов пока не было</p></div>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Партия</th><th>Когда</th><th>Записано</th><th>Пропущено</th><th>Состояние</th></tr></thead>
      <tbody>
      <% batches.forEach(function(b) { %>
        <tr>
          <td>№ <%= b.id %></td><td><%= formatDate(b.created_at) %></td><td><%= b.rows_ok %></td><td><%= b.rows_skipped %></td>
          <td>
            <% if (b.rolled_back_at) { %>отменена <%= formatDate(b.rolled_back_at) %>
            <% } else if (b.canRollback) { %>
              <form method="POST" action="/tools/import/<%= b.id %>/rollback" class="inline"><button type="submit" class="btn-secondary">Откатить (осталось ~<%= b.hoursLeft %> ч)</button></form>
            <% } else { %>действует; откат недоступен (&gt; <%= limits.hours %> ч)<% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>
<%- include('../_footer') %>
