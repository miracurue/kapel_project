<%- include('../_header') %>
<div class="card tools">
  <%- include('_back') %>
  <h1>Отчёт по когорте</h1>
  <p class="notice-honest">Только агрегаты по вашим закреплённым пациентам, без ФИО и ID. Учитываются пациенты с действующим клиническим согласием. Меньше <%= s.minN %> пациентов в разрезе — «слишком мало для агрегата». Справка, не заключение.</p>
  <% if (s.tooFewAll) { %>
    <div class="empty-state"><p class="empty-state__title"><%= s.tooFew %></p><p>Сейчас у вас пациентов в наблюдении: <%= s.total %>. Отчёт появится, когда их станет достаточно. Необязательно.</p></div>
  <% } else { %>
    <h2>Статусы светофора</h2>
    <div class="stat-grid">
      <% s.status.forEach(function(x) { %><div class="stat-card"><span class="stat-card__label"><%= x.label %></span><span class="stat-card__value"><%= x.n %></span></div><% }) %>
    </div>
    <form method="GET" action="/tools/cohort" class="filter-bar">
      <label>Шкала
        <select name="scale"><% s.scaleOptions.forEach(function(o) { %><option value="<%= o.code %>"<%= o.code === s.scale.code ? ' selected' : '' %>><%= o.title %></option><% }) %></select></label>
      <button type="submit" class="btn-secondary">Показать</button>
    </form>
    <h2>Распределение по уровню (последний результат): <%= s.scale.title %></h2>
    <% if (s.dist.tooFew) { %><p class="hint"><%= s.tooFew %> Пациентов с этой шкалой: <%= s.dist.n %>.</p>
    <% } else { %>
      <table><thead><tr><th>Уровень</th><th>Пациентов</th></tr></thead><tbody>
        <% s.dist.rows.forEach(function(r) { %><tr><td><%= r.label %></td><td><%= r.n %></td></tr><% }) %>
      </tbody></table>
      <p class="hint">Средний последний балл: <%= s.dist.mean %> (n = <%= s.dist.n %>)</p>
    <% } %>
    <h2>Динамика (первый → последний результат)</h2>
    <% if (s.dynamics.tooFew) { %><p class="hint"><%= s.tooFew %> Пациентов с двумя и более результатами: <%= s.dynamics.n %>.</p>
    <% } else { %>
      <p>Средний первый балл <strong><%= s.dynamics.meanFirst %></strong> → последний <strong><%= s.dynamics.meanLast %></strong> (изменение <%= s.dynamics.meanChange %>), n = <%= s.dynamics.n %>. Лучше: <%= s.dynamics.better %>, без изменений: <%= s.dynamics.same %>, хуже: <%= s.dynamics.worse %>.</p>
    <% } %>
    <h2>Приверженность (назначенные тесты за <%= s.adherence.days %> дн.)</h2>
    <% if (s.adherence.tooFew) { %><p class="hint"><%= s.tooFew %> Пациентов с назначениями: <%= s.adherence.patients %>.</p>
    <% } else { %><p>Пройдено <strong><%= s.adherence.done %></strong> из <strong><%= s.adherence.assigned %></strong><%= s.adherence.pct === null ? '' : ' (' + s.adherence.pct + '%)' %>.</p><% } %>
    <p class="no-print"><a class="btn-link" href="/tools/cohort.csv?scale=<%= s.scale.code %>">Скачать агрегаты (CSV)</a></p>
  <% } %>
</div>
<%- include('../_footer') %>
