<%- include('../_header') %>
<%- include('../patient/_back', { backHref: '/dashboard', backLabel: 'На главную' }) %>
<div class="card care">
  <h1>Сообщения врачу</h1>
  <p class="notice" role="note"><%= cfg.NOT_URGENT %> <a href="/help">Мне плохо</a></p>

  <% if (rec.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title">Вы пока не привязаны к врачу</p>
      <p><%= reason %></p>
      <p><a class="btn-link" href="/dashboard#link-doctor">Ввести код от врача</a> <a class="btn-link" href="/chat">ИИ-помощник</a></p>
    </div>
  <% } else { %>
    <% if (rec.length > 1) { %>
      <nav class="tabs" aria-label="Кому писать">
        <% rec.forEach(function(r) { %><a class="tabs__tab<%= sel && sel.id === r.id ? ' is-active' : '' %>" href="/messages?with=<%= r.id %>"<%- sel && sel.id === r.id ? ' aria-current="page"' : '' %>><%= r.full_name %></a><% }) %>
      </nav>
    <% } %>
    <h2><%= sel.full_name %></h2>
    <% if (sel.replyNote) { %><p class="muted">Врач указал: <%= sel.replyNote %></p><% } %>
    <% if (sel.away) { %><p class="notice-honest">Врач недоступен до <%= sel.away.split('-').reverse().join('.') %>.</p><% } %>

    <% if (thread.length === 0) { %>
      <div class="empty-state"><p class="empty-state__title">Сообщений пока нет</p><p>Писать необязательно. Врач может ответить не сразу.</p></div>
    <% } else { %>
      <ol class="cmsg-list">
        <% thread.forEach(function(m) { %>
          <li class="cmsg cmsg--<%= m.sender_role %>">
            <div class="cmsg__meta"><%= m.sender_role === 'patient' ? 'Вы' : sel.full_name %> · <%= formatDate(m.created_at) %>
              <% if (m.sender_role === 'patient') { %> · <span class="badge badge-muted"><%= m.read_at ? 'прочитано врачом ' + formatDate(m.read_at) : 'доставлено' %></span><% } %></div>
            <div class="cmsg__body"><%= m.body %></div>
          </li>
        <% }) %>
      </ol>
    <% } %>

    <% if (can.ok) { %>
      <form method="POST" action="/messages" data-draft-form>
        <input type="hidden" name="clinician_id" value="<%= sel.id %>" />
        <label for="msg-body">Ваше сообщение (до <%= max %> символов)</label>
        <textarea id="msg-body" name="body" data-draft-key="care-message" rows="4" maxlength="<%= max %>"><%= draft %></textarea>
        <p class="muted">Без вложений. Ответа в определённый срок сервис не обещает.</p>
        <p><button type="submit">Отправить</button></p>
      </form>
    <% } else { %>
      <p class="notice-honest" role="note"><%= reason %></p>
      <p><a class="btn-link" href="/chat">ИИ-помощник</a> <a class="btn-link" href="/help">Мне плохо</a></p>
    <% } %>
  <% } %>
</div>
<%- include('../_footer') %>
