<%- include('../_header') %>
<%- include('../patient/_back', { backHref: '/learn', backLabel: 'Все материалы' }) %>
<div class="card care care-module">
  <h1><%= mod.title %></h1>
  <p class="muted"><%= mod.minutes %> мин<%= m.assigned ? ' · назначил(а) ' + m.assigned.full_name : '' %></p>
  <p class="notice"><%= stub %></p>
  <% mod.sections.forEach(function(sec) { %>
    <h2><%= sec.h %></h2>
    <p><%= sec.p %></p>
  <% }) %>
  <div class="actions no-print">
    <% if (m.readAt) { %>
      <form method="POST" action="/learn/<%= m.key %>/read"><input type="hidden" name="done" value="0" /><button type="submit" class="btn-secondary">Вернуть в «не прочитано»</button></form>
    <% } else { %>
      <form method="POST" action="/learn/<%= m.key %>/read"><input type="hidden" name="done" value="1" /><button type="submit">Отметить прочитанным</button></form>
    <% } %>
    <button type="button" id="care-print" class="btn-secondary" hidden>Печать</button>
  </div>
</div>
<script src="/care.js" defer></script>
<%- include('../_footer') %>
