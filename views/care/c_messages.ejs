<%- include('../_header') %>
<div class="card clinician-card care">
  <%- include('../clinician/_patient_head') %>
  <h2>Сообщения</h2>
  <p class="hint">Это асинхронный канал «не для срочных случаев». Ответ необязателен. Кризисные фразы пациента попадают в «Кризисную очередь» отдельно.</p>
  <% if (!consentOk) { %>
    <div class="empty-state"><p class="empty-state__title">Сообщения недоступны</p><p>Нет действующего согласия пациента на передачу данных врачу.</p></div>
  <% } else { %>
    <% if (thread.length === 0) { %>
      <div class="empty-state"><p class="empty-state__title">Сообщений нет</p><p>Писать пациенту необязательно.</p></div>
    <% } else { %>
      <ol class="cmsg-list">
        <% thread.forEach(function(m) { %>
          <li class="cmsg cmsg--<%= m.sender_role === 'patient' ? 'patient' : 'clinician' %>">
            <div class="cmsg__meta"><%= m.sender_role === 'patient' ? patient.full_name : 'Вы' %> · <%= formatDate(m.created_at) %>
              <% if (m.sender_role === 'clinician') { %> · <span class="badge badge-muted"><%= m.read_at ? 'прочитано пациентом' : 'доставлено' %></span><% } else if (m.handled_at) { %> · <span class="badge badge-ok">обработано</span><% } %></div>
            <div class="cmsg__body"><%= m.body %></div>
          </li>
        <% }) %>
      </ol>
      <% if (openCount > 0) { %>
        <form method="POST" action="<%= base %>/messages/handled" class="inline"><button type="submit" class="btn-secondary">Отметить обработанным (<%= openCount %>)</button></form>
      <% } %>
    <% } %>
    <form method="POST" action="<%= base %>/messages">
      <label for="body">Ответ (до <%= cfg.MESSAGE_MAX %> символов)</label>
      <textarea id="body" name="body" rows="4" maxlength="<%= cfg.MESSAGE_MAX %>"><%= draft %></textarea>
      <p class="hint">Быстрые ответы (необязательно):
        <% cfg.QUICK_REPLIES.forEach(function(q) { %><a class="btn-link" href="<%= base %>/messages?tpl=<%= q.key %>"><%= q.text.slice(0, 28) %>…</a> <% }) %></p>
      <p><button type="submit">Отправить</button></p>
    </form>
  <% } %>
</div>
<%- include('../_footer') %>
