<%- include('../_header') %>
<%- include('../patient/_back', { backHref: '/dashboard', backLabel: 'На главную' }) %>
<div class="card care">
  <h1>Обучение</h1>
  <p class="muted">Короткие материалы на 3–5 минут. Читать их необязательно, вернуться можно в любой момент. Прочитано: <%= done %> из <%= modules.length %>.</p>
  <p class="notice"><%= stub %></p>
  <ul class="plain-list">
    <% modules.forEach(function(m) { %>
      <li class="item-card">
        <h2><a href="/learn/<%= m.key %>"><%= m.title %></a></h2>
        <p><%= m.summary %></p>
        <p class="muted"><%= m.minutes %> мин
          <% if (m.assigned) { %> · <span class="badge badge-info">назначил(а) <%= m.assigned.full_name %></span><% } %>
          · <span class="badge <%= m.readAt ? 'badge-ok' : 'badge-muted' %>"><%= m.readAt ? 'прочитано' : 'не прочитано' %></span></p>
      </li>
    <% }) %>
  </ul>
</div>
<%- include('../_footer') %>
