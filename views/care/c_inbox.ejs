<%- include('../_header') %>
<div class="card clinician-card care">
  <h1>Сообщения пациентов</h1>
  <p class="hint">Необязательный раздел: отвечать не требуется, ожидание ответа пациенту не обещается. Срочное идёт через «Кризисную очередь».</p>
  <% if (rows.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Сообщений нет</p><p>Когда пациент напишет вам, он появится здесь. Ничего делать не нужно.</p></div>
  <% } else { %>
    <table class="stack-mobile">
      <thead><tr><th>Пациент</th><th>Последнее сообщение</th><th>Статус</th></tr></thead>
      <tbody>
        <% rows.forEach(function(r) { %>
          <tr>
            <td data-label="Пациент"><a href="/patients/<%= r.patient_id %>/messages"><%= r.full_name %></a></td>
            <td data-label="Последнее"><%= r.last.sender_role === 'patient' ? '' : 'Вы: ' %><%= r.last.body.length > 80 ? r.last.body.slice(0, 80) + '…' : r.last.body %> <span class="hint"><%= formatDate(r.last.created_at) %></span></td>
            <td data-label="Статус"><% if (r.unread > 0) { %><span class="badge badge-info">новых: <%= r.unread %></span><% } else if (r.open_n > 0) { %><span class="badge badge-muted">не обработано</span><% } else { %><span class="badge badge-ok">обработано</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<div class="card clinician-card care">
  <h2>Моя доступность для сообщений</h2>
  <p class="hint">Необязательно. Пациент увидит эту подпись; на кризисные эскалации и обращения это не влияет.</p>
  <form method="POST" action="/inbox/settings">
    <label for="reply_note">Подпись для пациентов (например, «Отвечаю в рабочие дни до 18:00»)</label>
    <input type="text" id="reply_note" name="reply_note" maxlength="<%= cfg.REPLY_NOTE_MAX %>" value="<%= settings.reply_note || '' %>" />
    <label for="away_until">Недоступен для сообщений до</label>
    <input type="date" id="away_until" name="away_until" value="<%= settings.away_until || '' %>" />
    <p class="hint">Пока вы недоступны, пациент не сможет отправить вам сообщение и увидит, куда обратиться.</p>
    <p><button type="submit">Сохранить</button></p>
  </form>
</div>
<%- include('../_footer') %>
