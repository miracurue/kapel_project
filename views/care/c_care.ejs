<%- include('../_header') %>
<div class="card clinician-card care">
  <%- include('../clinician/_patient_head') %>
  <h2>Психообразовательные модули</h2>
  <p class="hint">Необязательно. Пациент и так видит все модули в разделе «Обучение»; назначение лишь выводит модуль на его главную. <%= stub %></p>
  <ul class="plain-list">
    <% modules.forEach(function(m) { %>
      <li class="item-card">
        <strong><%= m.title %></strong>
        <span class="badge <%= m.readAt ? 'badge-ok' : 'badge-muted' %>"><%= m.readAt ? 'прочитано' : 'не прочитано' %></span>
        <% if (m.assigned) { %><span class="hint">назначил(а) <%= m.assigned.full_name %>, <%= formatDate(m.assigned.assigned_at) %></span><% } %>
        <form method="POST" action="<%= base %>/learn/<%= m.assigned ? 'unassign' : 'assign' %>" class="inline">
          <input type="hidden" name="module" value="<%= m.key %>" />
          <button type="submit" class="btn-secondary"><%= m.assigned ? 'Снять назначение' : 'Назначить' %></button>
        </form>
      </li>
    <% }) %>
  </ul>

  <h2>Анкета перед приёмом</h2>
  <p class="hint">Необязательно. Пациент заполняет короткую анкету заранее, ответы появляются в справке «К приёму».</p>
  <% if (pv.open) { %>
    <p>Запрос отправлен <%= formatDate(pv.open.requested_at) %>, пациент ещё не ответил.
      <form method="POST" action="<%= base %>/previsit/cancel" class="inline"><button type="submit" class="btn-secondary">Отменить запрос</button></form></p>
  <% } else { %>
    <form method="POST" action="<%= base %>/previsit/request"><button type="submit">Попросить заполнить анкету</button></form>
  <% } %>
  <% if (pv.last) { %>
    <h3>Последние ответы (<%= formatDate(pv.last.at) %>)</h3>
    <% if (pv.last.rows.length === 0) { %><p class="hint">Пациент отправил анкету без ответов.</p><% } else { %>
      <dl class="pv-answers"><% pv.last.rows.forEach(function(r) { %><dt><%= r.q %></dt><dd><%= r.a %></dd><% }) %></dl>
    <% } %>
  <% } %>
</div>
<%- include('../_footer') %>
