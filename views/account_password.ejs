<%- include('_header') %>
<div class="card">
  <h1>Смена пароля</h1>
  <% if (forced) { %>
    <p class="notice-honest" role="note">Вы вошли с временным паролем. Пока вы не зададите новый пароль, остальные разделы недоступны.</p>
  <% } else { %>
    <p class="hint">После смены пароля все остальные ваши сессии будут завершены.</p>
  <% } %>
  <form method="POST" action="/account/password">
    <label for="current_password"><%= forced ? 'Временный пароль' : 'Текущий пароль' %></label>
    <input type="password" name="current_password" id="current_password" autocomplete="current-password" required />
    <label for="new_password">Новый пароль (не короче <%= min %> символов, не совпадает с e-mail)</label>
    <input type="password" name="new_password" id="new_password" autocomplete="new-password" required minlength="<%= min %>" />
    <label for="confirm_password">Повторите новый пароль</label>
    <input type="password" name="confirm_password" id="confirm_password" autocomplete="new-password" required minlength="<%= min %>" />
    <p><button type="submit">Сменить пароль</button> <% if (!forced) { %><a class="btn btn-secondary" href="/dashboard">Отмена</a><% } %></p>
  </form>
</div>
<%- include('_footer') %>
