<%- include('../_header') %>
<div class="card admin">
  <h1>Без врача</h1>
  <p class="notice-honest" role="note"><strong>Честно о каналах:</strong> <%= notifyText %> Если вы не откроете этот раздел, о записях никто не узнает. Рабочее время (пн–пт 9–18): SLA 15 мин; вне рабочего времени — 30 мин. Сейчас: <%= businessHours ? 'рабочее время' : 'нерабочее время' %>.</p>
  <p class="hint">Здесь эскалации и обращения пациентов, у которых нет активного врача, и эскалации без подтверждения в срок и без резерва. Текст и цитаты пациента администратору не показываются: решите, кому передать, или подтвердите обработку.</p>

  <h2>Ждут решения (<%= items.length %>)</h2>
  <% if (items.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title">Очередь пуста</p>
      <p>Когда пациент без врача пройдёт тест с тревожным ответом или нажмёт «связаться с человеком», запись появится здесь и в счётчике меню.</p>
    </div>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Тип</th><th>Пациент</th><th>Почему здесь</th><th>SLA</th><th>Действия</th></tr></thead>
      <tbody>
      <% items.forEach(function(it) { %>
        <tr class="crisis-row crisis-row--high">
          <td data-label="Тип">
            <% if (it.kind === 'escalation') { %><span class="badge badge-risk">Эскалация: <%= labels.tierLabel(it.tier) %></span>
              <div class="hint"><%- instrumentTag(it.instrument) %><% if (it.triggers.length) { %> · <%= it.triggers.map(triggerLabel).join(', ') %><% } %></div>
            <% } else { %><span class="badge badge-risk">Обращение пациента</span><% } %>
            <div class="hint"><%= formatDate(it.created_at) %></div>
          </td>
          <td data-label="Пациент"><%= it.patient_name %></td>
          <td data-label="Почему здесь"><%= it.why %></td>
          <td data-label="SLA"><% if (it.due_at) { var s = slaText(it.due_at); %><span class="sla <%= s.overdue ? 'sla--overdue' : 'sla--ok' %>"><span class="sla__state"><span aria-hidden="true"><%= s.overdue ? '⚠' : '⏱' %></span> <strong><%= s.overdue ? 'Просрочено' : 'В срок' %></strong></span><span class="sla__text"><%= s.text %></span><span class="sla__due">до <%= formatDate(it.due_at) %></span></span><% } else { %><span class="hint">без срока SLA</span><% } %></td>
          <td class="row-actions">
            <form method="POST" action="/admin/nobody/<%= it.ref %>/handover">
              <label for="h-<%= it.ref %>">Передать врачу</label>
              <select name="clinician_id" id="h-<%= it.ref %>" required>
                <option value="">— выбрать —</option>
                <% clinicians.forEach(function(c) { %><option value="<%= c.id %>"><%= c.full_name %> (<%= c.role === 'psychiatrist' ? 'психиатр' : 'психолог' %>)</option><% }) %>
              </select>
              <button type="submit">Передать</button>
            </form>
            <form method="POST" action="/admin/nobody/<%= it.ref %>/acknowledge">
              <button type="submit" class="btn-secondary">Подтвердить обработку</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <p class="hint">«Передать» закрепляет пациента за выбранным специалистом и сразу показывает запись в его кризисной очереди. «Подтвердить» означает, что вы связались с пациентом вне сервиса или решили вопрос иначе.</p>
  <% } %>

  <h2>Недавно обработано администраторами</h2>
  <% if (handled.length === 0) { %>
    <p class="hint">Пока ничего.</p>
  <% } else { %>
    <ul class="plain-list">
      <% handled.forEach(function(h) { %><li><%= h.label %> · <%= h.patient_name %> · <%= formatDate(h.at) %> · <%= h.by %></li><% }) %>
    </ul>
  <% } %>
</div>
<%- include('../_footer') %>
