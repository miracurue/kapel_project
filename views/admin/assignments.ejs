<%- include('../_header') %>
<div class="card admin">
  <h1>Привязки пациент ↔ специалист</h1>
  <p class="hint">Администратор видит имена и число открытых эскалаций, но не клиническое содержимое. При уходе врача используйте «Переназначить пациентов» в его карточке.</p>
  <form method="GET" action="/admin/assignments" class="filter-bar">
    <label for="f-q">Поиск по ФИО пациента <input type="search" id="f-q" name="q" value="<%= q %>" /></label>
    <label for="f-clin">Специалист
      <select name="clinician" id="f-clin">
        <option value="">Все пациенты</option>
        <option value="none"<%= clinician === 'none' ? ' selected' : '' %>>Без активного врача</option>
        <% allClinicians.forEach(function(c) { %><option value="<%= c.id %>"<%= String(c.id) === clinician ? ' selected' : '' %>><%= c.full_name %><%= c.deactivated_at ? ' (деактивирован)' : '' %></option><% }) %>
      </select>
    </label>
    <button type="submit" class="btn-secondary">Показать</button>
    <% if (q || clinician) { %><a href="/admin/assignments">Сбросить</a><% } %>
  </form>
  <% if (rows.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Пациентов не найдено</p><p>Измените фильтры. Пациенты появляются здесь после регистрации.</p></div>
  <% } else { %>
    <p class="hint">Найдено: <%= total %></p>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Пациент</th><th>Специалисты</th><th>Открытых эскалаций</th><th></th></tr></thead>
      <tbody>
      <% rows.forEach(function(p) { %>
        <tr>
          <td data-label="Пациент"><%= p.full_name %><% if (p.account_status !== 'active') { %> <span class="badge badge-muted">запрошено удаление</span><% } %></td>
          <td data-label="Специалисты">
            <% if (p.clinicians.length === 0) { %><span class="badge badge-warn">нет врача</span>
            <% } else { %><% p.clinicians.forEach(function(c, i) { %><%= i ? ', ' : '' %><%= c.full_name %><%= c.deactivated_at ? ' (деактивирован)' : '' %><% }) %>
              <% if (p.noActive) { %><span class="badge badge-warn">нет активного врача</span><% } %>
            <% } %>
          </td>
          <td data-label="Открытых эскалаций"><%= p.open_esc ? p.open_esc : '—' %></td>
          <td><a href="/admin/assignments/patient/<%= p.id %>">Изменить</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <%- include('_pager', { base: '/admin/assignments', params: { q: q, clinician: clinician }, page: page, pages: pages }) %>
  <% } %>
</div>
<%- include('../_footer') %>
