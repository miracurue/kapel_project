<%- include('../_header') %>
<div class="card admin">
  <h1>Требует решения</h1>
  <p class="hint">Служебный кабинет. Клинических данных пациентов здесь нет: вы видите только очереди и действия. <%= notifyText %></p>

  <% var nothing = d.deletion === 0 && d.noDoctorTotal === 0 && d.passwordResets.length === 0; %>
  <div class="stat-grid">
    <a class="stat-card stat-card--link<%= d.noDoctorTotal ? ' stat-card--risk' : '' %>" href="/admin/nobody">
      <div class="stat-card__label">Без врача и без резерва</div>
      <div class="stat-card__value"><%= d.noDoctorTotal %></div>
      <div class="stat-card__hint">эскалаций: <%= d.noDoctorEscalations %>, обращений пациентов: <%= d.noDoctorAppeals %></div>
    </a>
    <a class="stat-card stat-card--link" href="/admin/deletion">
      <div class="stat-card__label">Запросы на удаление</div>
      <div class="stat-card__value"><%= d.deletion %></div>
      <div class="stat-card__hint">ждут исполнения</div>
    </a>
    <a class="stat-card stat-card--link" href="/admin/users?status=password">
      <div class="stat-card__label">Ждут смены пароля</div>
      <div class="stat-card__value"><%= d.passwordResets.length %></div>
      <div class="stat-card__hint">выдан временный пароль</div>
    </a>
    <a class="stat-card stat-card--link" href="/admin/assignments?clinician=none">
      <div class="stat-card__label">Пациенты без врача</div>
      <div class="stat-card__value"><%= d.patientsWithoutDoctor %></div>
      <div class="stat-card__hint">для справки; не всегда срочно</div>
    </a>
  </div>

  <% if (nothing) { %>
    <div class="empty-state">
      <p class="empty-state__title">Сейчас ничего не требует решения</p>
      <p>Новые запросы на удаление, эскалации и обращения пациентов без врача появятся здесь и в счётчиках меню.</p>
    </div>
  <% } %>

  <% if (d.passwordResets.length) { %>
    <h2>Пользователи с временным паролем</h2>
    <p class="hint">Они ещё не сменили пароль. Если человек не может войти, выдайте новый временный пароль в его карточке.</p>
    <ul class="plain-list">
      <% d.passwordResets.forEach(function(u) { %>
        <li><a href="/admin/users/<%= u.id %>"><%= u.full_name %></a> <span class="hint">(<%= ({ patient: 'пациент', psychiatrist: 'психиатр', psychologist: 'психолог', admin: 'администратор' })[u.role] %>)</span></li>
      <% }) %>
    </ul>
  <% } %>

  <h2>Быстрые действия</h2>
  <p class="row-actions-inline">
    <a class="btn" href="/admin/users/new">Создать сотрудника</a>
    <a class="btn btn-secondary" href="/admin/invites">Выдать код-приглашение</a>
    <a class="btn btn-secondary" href="/admin/audit">Журналы</a>
  </p>
</div>
<%- include('../_footer') %>
