<%- include('../_header') %>
<div class="card admin">
  <h1>Новый сотрудник</h1>
  <p class="hint">Публичная регистрация врачей закрыта: учётную запись создаёте вы. Система выдаст временный пароль и покажет его один раз; при первом входе человек обязан задать свой.</p>
  <% if (error) { %><div class="flash flash-error" role="alert"><span class="flash__icon" aria-hidden="true">!</span><span><%= error %></span></div><% } %>
  <form method="POST" action="/admin/users">
    <label for="full_name">ФИО</label>
    <input type="text" name="full_name" id="full_name" required value="<%= values.full_name || '' %>" />
    <label for="email">E-mail (логин)</label>
    <input type="email" name="email" id="email" required autocomplete="off" value="<%= values.email || '' %>" />
    <label for="role">Роль</label>
    <select name="role" id="role" required>
      <% [['psychiatrist','Психиатр'],['psychologist','Клинический психолог'],['admin','Администратор']].forEach(function(r) { %>
        <option value="<%= r[0] %>"<%= values.role === r[0] ? ' selected' : '' %>><%= r[1] %></option>
      <% }) %>
    </select>
    <p><button type="submit">Создать и показать временный пароль</button> <a class="btn btn-secondary" href="/admin/users">Отмена</a></p>
  </form>
</div>
<%- include('../_footer') %>
