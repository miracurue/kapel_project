<%- include('../_header') %>
<div class="card admin">
  <h1>Пользователи</h1>
  <p><a class="btn" href="/admin/users/new">Создать сотрудника</a></p>
  <form method="GET" action="/admin/users" class="filter-bar">
    <label for="f-q">Поиск по ФИО или e-mail <input type="search" id="f-q" name="q" value="<%= f.q %>" /></label>
    <label for="f-role">Роль
      <select name="role" id="f-role"><option value="">Любая</option>
        <% [['patient','Пациент'],['psychiatrist','Психиатр'],['psychologist','Психолог'],['admin','Администратор']].forEach(function(r) { %>
          <option value="<%= r[0] %>"<%= f.role === r[0] ? ' selected' : '' %>><%= r[1] %></option>
        <% }) %>
      </select>
    </label>
    <label for="f-status">Статус
      <select name="status" id="f-status"><option value="">Любой</option>
        <% [['active','Активен'],['password','Ждёт смены пароля'],['deactivated','Деактивирован'],['deletion_requested','Запрошено удаление'],['deleted','Данные удалены']].forEach(function(r) { %>
          <option value="<%= r[0] %>"<%= f.status === r[0] ? ' selected' : '' %>><%= r[1] %></option>
        <% }) %>
      </select>
    </label>
    <button type="submit" class="btn-secondary">Найти</button>
    <% if (f.q || f.role || f.status) { %><a href="/admin/users">Сбросить</a><% } %>
  </form>
  <% if (rows.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title">Никого не найдено</p>
      <p>Измените поиск или сбросьте фильтры. Нового врача можно создать кнопкой выше.</p>
    </div>
  <% } else { %>
    <p class="hint">Найдено: <%= total %></p>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>ФИО</th><th>Роль</th><th>E-mail</th><th>Статус</th></tr></thead>
      <tbody>
      <% rows.forEach(function(u) { %>
        <tr>
          <td data-label="ФИО"><a href="/admin/users/<%= u.id %>"><%= u.full_name %></a></td>
          <td data-label="Роль"><%= roleLabels[u.role] %></td>
          <td data-label="E-mail"><%= u.email %></td>
          <td data-label="Статус"><span class="badge <%= u.status.key === 'active' ? 'badge-ok' : (u.status.key === 'password' ? 'badge-warn' : 'badge-muted') %>"><%= u.status.label %></span></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <%- include('_pager', { base: '/admin/users', params: { q: f.q, role: f.role, status: f.status }, page: page, pages: pages }) %>
  <% } %>
</div>
<%- include('../_footer') %>
