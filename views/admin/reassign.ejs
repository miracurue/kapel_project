<%- include('../_header') %>
<div class="card admin">
  <p><a href="/admin/users/<%= from.id %>">&larr; <%= from.full_name %></a></p>
  <h1>Переназначить пациентов</h1>
  <p>Специалист: <strong><%= from.full_name %></strong><%= from.deactivated_at ? ' (деактивирован)' : '' %>. Выбранные пациенты будут сняты с него и закреплены за новым специалистом одним действием.</p>
  <% if (patients.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">У специалиста нет пациентов</p><p>Переназначать нечего.</p></div>
  <% } else if (targets.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Нет другого активного специалиста</p><p><a href="/admin/users/new">Создайте сотрудника</a>, чтобы передать ему пациентов.</p></div>
  <% } else { %>
  <form method="POST" action="/admin/assignments/reassign">
    <input type="hidden" name="from" value="<%= from.id %>" />
    <label for="to">Новый специалист
      <select name="to" id="to" required>
        <% targets.forEach(function(c) { %><option value="<%= c.id %>"><%= c.full_name %> (<%= c.role === 'psychiatrist' ? 'психиатр' : 'психолог' %>)</option><% }) %>
      </select>
    </label>
    <fieldset class="plain-fieldset">
      <legend>Пациенты (по умолчанию выбраны все)</legend>
      <% patients.forEach(function(p) { %>
        <label><input type="checkbox" name="patient_ids" value="<%= p.id %>" checked /> <span><%= p.full_name %><% if (p.open_esc) { %> <span class="badge badge-risk">открытых эскалаций: <%= p.open_esc %></span><% } %></span></label>
      <% }) %>
    </fieldset>
    <div class="notice-honest" role="note">
      <p>Открытые эскалации выбранных пациентов станут видны новому специалисту в его кризисной очереди сразу после переназначения. Действие запишется в журнал администраторов по каждому пациенту.</p>
    </div>
    <p><button type="submit">Переназначить выбранных</button> <a class="btn btn-secondary" href="/admin/users/<%= from.id %>">Отмена</a></p>
  </form>
  <% } %>
</div>
<%- include('../_footer') %>
