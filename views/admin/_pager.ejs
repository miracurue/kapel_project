<%# Пагинация. Вход: base (путь), params (объект фильтров), page, pages %>
<% if (pages > 1) {
  var qs = function(p) { var u = new URLSearchParams(); Object.keys(params || {}).forEach(function(k) { if (params[k]) u.set(k, params[k]); }); u.set('page', p); return base + '?' + u.toString(); };
%>
<nav class="admin-pager" aria-label="Страницы">
  <% if (page > 1) { %><a class="btn btn-secondary" href="<%= qs(page - 1) %>">&larr; Назад</a><% } %>
  <span>Страница <%= page %> из <%= pages %></span>
  <% if (page < pages) { %><a class="btn btn-secondary" href="<%= qs(page + 1) %>">Вперёд &rarr;</a><% } %>
</nav>
<% } %>
