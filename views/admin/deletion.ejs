<%- include('../_header') %>
<div class="card admin">
  <h1>Запросы на удаление данных</h1>
  <p class="hint">Пациент отозвал согласие и просит удалить данные (152-ФЗ, ст. 14 и 21). Ожидаемый срок исполнения — <%= dueDays %> дней от даты запроса (<em>review-required</em>: срок подтверждает юрист).</p>

  <h2>Ждут исполнения (<%= pending.length %>)</h2>
  <% if (pending.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Запросов нет</p><p>Когда пациент нажмёт «Запросить удаление» в своём кабинете, запрос появится здесь и в счётчике меню.</p></div>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Пациент</th><th>Дата запроса</th><th>Ожидаемый срок</th><th>Статус</th><th></th></tr></thead>
      <tbody>
      <% pending.forEach(function(r) { %>
        <tr>
          <td data-label="Пациент"><%= r.patient_name %></td>
          <td data-label="Дата запроса"><%= formatDate(r.requested_at) %></td>
          <td data-label="Ожидаемый срок"><%= r.due_at ? formatDate(r.due_at) : '—' %></td>
          <td data-label="Статус"><span class="badge badge-warn">ожидает исполнения</span></td>
          <td><a class="btn btn-secondary" href="/admin/deletion/<%= r.id %>">Открыть</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>

  <h2>Исполненные</h2>
  <% if (done.length === 0) { %>
    <p class="hint">Исполненных запросов пока нет.</p>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Запрос</th><th>Дата запроса</th><th>Исполнен</th><th></th></tr></thead>
      <tbody>
      <% done.forEach(function(r) { %>
        <tr>
          <td data-label="Запрос">№<%= r.id %> (<%= r.patient_name %>)</td>
          <td data-label="Дата запроса"><%= formatDate(r.requested_at) %></td>
          <td data-label="Исполнен"><%= r.executed_at ? formatDate(r.executed_at) : (r.status === 'cancelled' ? 'отменён пациентом' : '—') %></td>
          <td><a href="/admin/deletion/<%= r.id %>"><%= r.status === 'executed' ? 'Отчёт' : 'Открыть' %></a></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>
<%- include('../_footer') %>
