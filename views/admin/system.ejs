<%- include('../_header') %>
<div class="card admin">
  <h1>Система</h1>
  <p class="hint">Только чтение. Значения порогов и сроков — <em>review-required</em>: их меняет владелец продукта, а не администратор.</p>
  <% if (s.warnings.length) { %>
    <div class="flash flash-error" role="alert"><span class="flash__icon" aria-hidden="true">!</span>
      <span><strong>Предупреждения:</strong>
        <ul><% s.warnings.forEach(function(w) { %><li><%= w %></li><% }) %></ul>
      </span></div>
  <% } else { %>
    <p class="flash flash-success" role="status"><span class="flash__icon" aria-hidden="true">✓</span><span>Секреты окружения заданы.</span></p>
  <% } %>
  <dl class="kv">
    <dt>Версия</dt><dd><%= s.version %> (Node <%= s.node %>)</dd>
    <dt>Режим</dt><dd><%= s.mode %></dd>
    <dt>Размер БД</dt><dd><%= s.dbSize === null ? 'неизвестен' : (s.dbSize / 1024).toFixed(0) + ' КБ' %></dd>
    <dt>Пользователи</dt><dd>
      пациентов: <%= s.byRole.patient || 0 %>, психиатров: <%= s.byRole.psychiatrist || 0 %>, психологов: <%= s.byRole.psychologist || 0 %>, администраторов: <%= s.byRole.admin || 0 %>
    </dd>
  </dl>
  <h2>Конфигурация (только чтение)</h2>
  <dl class="kv">
    <dt>SLA подтверждения кризиса</dt><dd>рабочее время (<%= s.config.businessHours %>): <%= s.config.sla.business %> мин; вне рабочего времени: <%= s.config.sla.off %> мин</dd>
    <dt>Срок исполнения удаления</dt><dd><%= s.config.deletionDueDays %> дней от запроса</dd>
    <dt>Срок жизни псевдонима экспорта</dt><dd><%= s.config.pseudonymTtlDays %> дней</dd>
    <dt>Светофор врача</dt><dd>
      нет активности: <%= s.config.triage.inactivityDays %> дн.; просрочено назначение: <%= s.config.triage.overdueAssignmentDays %> дн.;
      окно ухудшения: <%= s.config.triage.worseningWindowDays %> дн.; низкая приверженность: менее <%= Math.round(s.config.triage.adherenceMinRatio * 100) %>% за <%= s.config.triage.adherenceWindowDays %> дн.
    </dd>
  </dl>
</div>
<%- include('../_footer') %>
