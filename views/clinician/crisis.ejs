<%- include('../_header') %>
<div class="card crisis-queue">
  <h1>Кризисная очередь</h1>
  <p class="notice-honest" role="note"><strong>Честно о каналах:</strong> <%= notifyText %> Рабочее время (пн–пт 9–18): SLA 15 мин; вне рабочего времени — 30 мин. Сейчас: <%= businessHours ? 'рабочее время' : 'нерабочее время' %>.</p>

  <h2>Ждут подтверждения (<%= openCount %>)</h2>
  <% if (groups.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title">Открытых эскалаций нет</p>
      <p>Новые эскалации и обращения пациентов появятся здесь и в счётчике меню. Просрочка SLA проверяется при любом открытии кабинета.</p>
    </div>
  <% } %>
  <% groups.forEach(function(g) { %>
    <section class="crisis-group" aria-label="Пациент <%= g.patient_name %>">
      <h3><a href="/patients/<%= g.patient_id %>"><%= g.patient_name %></a>
        <% if (g.items.length > 1) { %><span class="badge badge-risk"><%= g.items.length %> записей</span> <span class="hint">последняя: <%= formatDate(g.latest.created_at) %></span><% } %></h3>
      <div class="table-responsive"><table class="stack-mobile">
        <thead><tr><th>Тип</th><th>Что сработало</th><th>SLA</th><th>Передача</th><th></th></tr></thead>
        <tbody>
        <% g.items.forEach(function(c) { %>
          <tr class="crisis-row crisis-row--<%= c.effTier >= 2 ? 'high' : 'mon' %>">
            <td>
              <% if (c.kind === 'appeal') { %><span class="badge badge-risk">Обращение пациента</span>
              <% } else { %><span class="badge <%= c.tier >= 2 ? 'badge-risk' : 'badge-warn' %>"><%= labels.tierLabel(c.tier) %></span><% } %>
              <div class="hint"><%= formatDate(c.created_at) %></div>
            </td>
            <td>
              <% if (c.kind !== 'appeal') { %><div><%- instrumentTag(c.instrument) %><% if (c.triggers.length) { %> · триггеры: <%= c.triggers.map(triggerLabel).join(', ') %><% } %></div><% } %>
              <div><%= c.reasons.map(function(r) { return labels.cleanReason(String(r).slice(0, 200)); }).join('; ') %></div>
              <a href="/crisis/<%= c.ref %>">Подробнее</a>
            </td>
            <td><%- include('_sla', { c: c }) %></td>
            <td>
              <% if (c.escalated_to_backup_at && c.backup_name) { %>передано: <%= c.backup_name %> в <%= formatDate(c.escalated_to_backup_at) %>
              <% } else if (c.unresolved) { %><strong>Нет резерва — разбор вручную</strong>
              <% } else { %><span class="hint">—</span><% } %>
            </td>
            <td><%- include('_ack_form', { c: c, outcomes: outcomes }) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </section>
  <% }) %>

  <h2>Подтверждённые недавно</h2>
  <% if (acked.length === 0) { %>
    <p class="hint">Пока нет подтверждённых записей.</p>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Пациент</th><th>Тип</th><th>Что сработало</th><th>Подтверждено</th><th></th></tr></thead>
      <tbody>
      <% acked.forEach(function(c) { %>
        <tr>
          <td><a href="/patients/<%= c.patient_id %>"><%= c.patient_name %></a></td>
          <td><%= c.kind === 'appeal' ? 'Обращение пациента' : labels.tierLabel(c.tier) %></td>
          <td><%= c.reasons.map(function(r) { return labels.cleanReason(String(r).slice(0, 200)); }).join('; ') %></td>
          <td><%= formatDate(c.acknowledged_at) %><% if (c.ack_outcome && outcomes[c.ack_outcome]) { %> · <%= outcomes[c.ack_outcome] %><% } %></td>
          <td><a href="/crisis/<%= c.ref %>">Подробнее</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
  <p class="result-disclaimer"><%= TRIAGE_DISCLAIMER %></p>
</div>
<script src="/sla.js" defer></script>
<%- include('../_footer') %>
