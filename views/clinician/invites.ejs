<%- include('../_header') %>
<div class="card clinician-card">
  <h1>Коды-приглашения</h1>
  <p class="hint">Код привязывает пациента к вам при регистрации или позже. Он одноразовый, действует <%= ttl %> дн. и не раскрывает ваше имя до использования.</p>
  <% if (fresh) { %>
    <div class="notice-honest" role="status">
      <p>Новый код: <strong class="pc-code"><%= fresh %></strong></p>
      <p class="hint">Передайте пациенту лично. Пока код действует, он виден и в списке ниже.</p>
    </div>
  <% } %>
  <form method="POST" action="/invites"><button type="submit">Создать код</button></form>

  <h2>Ваши коды</h2>
  <% if (list.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Кодов пока нет</p><p>Создайте код, чтобы пригласить пациента. Необязательно.</p></div>
  <% } else { %>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Код</th><th>Состояние</th><th>Создан</th><th>Действует до</th><th></th></tr></thead>
      <tbody>
      <% var labels = { active: 'действует', used: 'использован', expired: 'истёк', revoked: 'отозван' }; %>
      <% list.forEach(function(c) { %>
        <tr>
          <td><% if (c.state === 'active') { %><code class="pc-code"><%= c.code %></code><% } else { %><code><%= c.code.slice(0, 2) %>••-••••</code><% } %></td>
          <td><span class="badge <%= c.state === 'active' ? 'badge-ok' : 'badge-muted' %>"><%= labels[c.state] %></span></td>
          <td><%= formatDate(String(c.created_at).slice(0, 10)) %></td>
          <td><%= formatDate(String(c.expires_at).slice(0, 10)) %></td>
          <td><% if (c.state === 'active') { %>
            <form method="POST" action="/invites/<%= c.id %>/revoke" class="inline"><button type="submit" class="btn-secondary">Отозвать</button></form>
          <% } %></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>
<%- include('../_footer') %>
