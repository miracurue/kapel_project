<%# Подтверждение «Обработано»: исход и заметка необязательны. Вход: c, outcomes %>
<form method="POST" action="/crisis/<%= c.ref %>/acknowledge" class="ack-form">
  <button type="submit">Обработано</button>
  <details class="why"><summary>Исход и заметка (необязательно)</summary>
    <label>Исход
      <select name="outcome"><option value="">— не указывать —</option>
        <% Object.keys(outcomes).forEach(function(k) { %><option value="<%= k %>"><%= outcomes[k] %></option><% }) %>
      </select>
    </label>
    <label>Заметка <textarea name="note" rows="2" maxlength="500"></textarea></label>
  </details>
</form>
