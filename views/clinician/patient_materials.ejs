<%- include('../_header') %>
<div class="card clinician-card">
  <%- include('_patient_head') %>
  <h2>Материалы</h2>
  <% if (!consentOk) { %>
    <div class="empty-state"><p class="empty-state__title">Материалы не показываются</p><p>У пациента нет действующего клинического согласия.</p></div>
  <% } else if (docs.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title">Документов, привязанных к этому пациенту, нет</p>
      <p>Здесь видны материалы, которые вы сами загрузили в <a href="/ai">ИИ-пространство</a> в диалоге с привязкой к этому пациенту. Необязательно.</p>
    </div>
  <% } else { %>
    <p class="hint">Видны только вам как автору. Хранятся ограниченный срок, затем удаляются автоматически.</p>
    <div class="table-responsive"><table class="stack-mobile">
      <thead><tr><th>Документ</th><th>Загружен</th><th>Хранится до</th><th>Маскирование</th><th>Действия</th></tr></thead>
      <tbody>
      <% docs.forEach(function(m) { %>
        <tr>
          <td><%= m.name %></td>
          <td><%= formatDate(m.created_at) %></td>
          <td><%= formatDate(m.expires_at) %></td>
          <td><%= m.masked ? 'персональные данные замаскированы: ' + m.mask_count : 'без маскирования' %></td>
          <td class="row-actions">
            <a href="/ai/t/<%= m.thread_id %>">Открыть диалог</a>
            <a href="/ai/materials/<%= m.id %>/download">Скачать</a>
            <a href="/ai/materials/<%= m.id %>/delete">Удалить</a>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div>
<%- include('../_footer') %>
