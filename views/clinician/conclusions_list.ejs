<%- include('../_header') %>
<div class="card concl">
  <h1>Заключения</h1>
  <p class="hint">Рабочее место заключений. Черновики видят автор и психиатр (психиатру — только чтение, с пометкой «черновик психолога, не подписано»); подписанные доступны закреплённым врачам для чтения. Пациенту заключение не показывается, пока психолог явно не выдаст его.</p>
  <p class="notice-honest" role="note"><%= signNotice %> Шаблон разделов — заглушка (review-required).</p>

  <form method="GET" action="/conclusions" class="filter-bar" role="search">
    <label>Поиск по тексту, методике <input type="search" name="q" value="<%= f.q %>" maxlength="100" /></label>
    <label>Статус
      <select name="status">
        <option value="">Все</option>
        <option value="draft"<%= f.status === 'draft' ? ' selected' : '' %>>Черновик</option>
        <option value="signed"<%= f.status === 'signed' ? ' selected' : '' %>>Подписано</option>
      </select>
    </label>
    <label>С даты <input type="date" name="from" value="<%= f.from %>" /></label>
    <label>По дату <input type="date" name="to" value="<%= f.to %>" /></label>
    <button type="submit" class="btn-secondary">Найти</button>
    <% if (f.q || f.status || f.from || f.to) { %><a href="/conclusions">Сбросить</a><% } %>
  </form>

  <% if (rows.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title"><%= (f.q || f.status || f.from || f.to) ? 'Ничего не найдено' : 'Заключений пока нет' %></p>
      <% if (canWrite) { %><p>Создайте черновик из карточки пациента (вкладка «Заключения») или выберите пациента ниже. Это необязательно.</p><% } else { %><p>Здесь появятся подписанные заключения психологов по вашим пациентам.</p><% } %>
    </div>
  <% } else { %>
    <div class="table-wrap"><table class="stack-mobile">
      <thead><tr><th>Пациент</th><th>Заключение</th><th>Статус</th><th>Версия</th><th>Автор</th><th>Обновлено</th></tr></thead>
      <tbody>
      <% rows.forEach(function(r) { %>
        <tr>
          <td data-label="Пациент"><a href="/patients/<%= r.patient_id %>/conclusions"><%= r.patient_name %></a></td>
          <td data-label="Заключение"><a href="/conclusions/<%= r.id %>"><%= r.latest.title || ('Заключение №' + r.id) %></a></td>
          <td data-label="Статус">
            <% if (r.state === 'signed') { %><span class="badge badge-ok"><span aria-hidden="true">✔</span> подписано</span>
            <% } else if (!r.mine) { %><span class="badge badge-warn"><span aria-hidden="true">✎</span> черновик психолога, не подписано</span>
            <% } else if (r.state === 'revision') { %><span class="badge badge-warn"><span aria-hidden="true">✎</span> правка (черновик), есть подписанная версия</span>
            <% } else { %><span class="badge badge-warn"><span aria-hidden="true">✎</span> черновик</span><% } %>
            <% if (r.released_to_patient) { %><span class="badge badge-info">выдано пациенту</span><% } %>
          </td>
          <td data-label="Версия"><%= r.latest.version %></td>
          <td data-label="Автор"><%= r.author_name %></td>
          <td data-label="Обновлено"><%= formatDate(String(r.updated_at || r.created_at).slice(0, 10)) %></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>

  <% if (found && found.length) { %>
    <h2>Найденные протоколы</h2>
    <ul class="pc-journal">
      <% found.forEach(function(p) { %>
        <li><time><%= formatDate(p.date) %></time> <%= p.title %> — <a href="/patients/<%= p.patient_id %>/<%= p.session_id ? 'exam/' + p.session_id : 'offline' %>"><%= p.patient_name %></a></li>
      <% }) %>
    </ul>
  <% } %>

  <% if (canWrite) { %>
    <h2>Новое заключение</h2>
    <% if (myPatients.length === 0) { %>
      <p class="hint">Нет закреплённых пациентов.</p>
    <% } else { %>
      <ul class="concl-patients">
        <% myPatients.forEach(function(p) { %><li><a href="/patients/<%= p.id %>/conclusions"><%= p.full_name %></a></li><% }) %>
      </ul>
    <% } %>
  <% } %>
</div>
<%- include('../_footer') %>
