<%- include('../_header') %>
<div class="card clinician-card">
  <%- include('_patient_head') %>
  <h2>Шкалы и динамика</h2>
  <% if (!consentOk) { %>
    <div class="empty-state"><p class="empty-state__title">Онлайн-результаты не передаются</p><p>Нет действующего клинического согласия. Очные результаты, введённые врачом, показываются ниже, если они есть.</p></div>
  <% } %>
  <% if (codes.length === 0) { %>
    <div class="empty-state">
      <p class="empty-state__title">Пока нет результатов для графика</p>
      <p>Назначьте тест или введите очный результат во вкладке «Офлайн-ввод и сравнение». Необязательно, заполнять ничего не нужно.</p>
    </div>
  <% } else { %>
    <form method="GET" action="<%= base %>/scales" class="filter-bar">
      <label>Шкала
        <select name="scale">
          <% codes.forEach(function(c) { %><option value="<%= c %>"<%= c === code ? ' selected' : '' %>><%= instrumentLabel(c) %></option><% }) %>
        </select>
      </label>
      <label>Период
        <select name="period">
          <% periods.forEach(function(p) { %><option value="<%= p.key %>"<%= p.key === per.key ? ' selected' : '' %>><%= p.label %></option><% }) %>
        </select>
      </label>
      <button type="submit" class="btn-secondary">Показать</button>
    </form>
    <h3><%- instrumentTag(code) %><% if (isCatalogStub(code)) { %> <span class="badge badge-warn">демо-балл</span><% } %></h3>
    <% if (rows.length === 0) { %>
      <div class="empty-state"><p>За выбранный период результатов нет. Выберите больший период.</p></div>
    <% } else { %>
      <%- chart %>
      <p class="pc-legend" aria-label="Обозначения графика">
        <% if (kinds.includes('online')) { %><span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle class="pc-mark" cx="7" cy="7" r="5"/></svg> онлайн (пациент)</span><% } %>
        <% if (kinds.includes('offline')) { %><span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect class="pc-mark" x="2" y="2" width="10" height="10"/></svg> очно (бланк)</span><% } %>
        <% if (kinds.includes('protocol')) { %><span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><polygon class="pc-mark" points="7,1 13,7 7,13 1,7"/></svg> протокол врача</span><% } %>
        <% if (hasStub) { %><span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle class="pc-mark is-demo" cx="7" cy="7" r="5"/></svg> полый — демо-балл</span><% } %>
        <% if (isHads) { %><span>сплошная линия — HADS-A, пунктир — HADS-D</span><% } %>
      </p>
      <h3>Таблица (те же данные)</h3>
      <div class="table-responsive"><table class="stack-mobile">
        <thead><tr><th>Дата</th><th>Источник</th><th>Балл</th><th>Уровень</th><th>Пометки</th><th>Действия</th></tr></thead>
        <tbody>
        <% rows.forEach(function(r) { %>
          <tr data-instrument="<%= r.instrument %>">
            <td><%= formatDate(r.date || String(r.at).slice(0, 10)) %></td>
            <td><%= sourceLabel[r.kind] %></td>
            <td><% if (r.instrument === 'hads' && r.subscales) { %>A <%= r.subscales.A %> · D <%= r.subscales.D %><% } else { %><%= r.total === null ? '—' : r.total %><% } %></td>
            <td><%= r.band || '—' %></td>
            <td><% if (r.stub) { %><span class="badge badge-warn">демо-балл</span> <% } %><% if (r.risk) { %><span class="badge badge-info">флаг шкалы</span><% } %></td>
            <td class="row-actions">
              <% if (r.kind !== 'online') { %>
                <form method="POST" action="<%= base %>/results/<%= r.kind %>/<%= r.rid %>/invalid">
                  <input type="hidden" name="back" value="<%= base %>/scales?scale=<%= code %>" />
                  <details><summary>Ошибочный ввод</summary>
                    <label>Причина (необязательно) <input type="text" name="reason" maxlength="200" /></label>
                    <button type="submit" class="btn-secondary">Пометить: исключить из динамики и экспорта</button>
                  </details>
                </form>
              <% } else { %><span class="hint">онлайн-результат пациента</span><% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <% if (hasStub) { %><p class="result-disclaimer"><%= STUB_DISCLAIMER %> Результаты по заглушкам не интерпретируются и не влияют на светофор.</p><% } %>
    <% } %>
    <% if (excluded.length) { %>
      <details class="pc-excluded"><summary>Исключено как ошибочный ввод: <%= excluded.length %></summary>
        <ul>
          <% excluded.forEach(function(r) { %>
            <li><%- instrumentTag(r.instrument) %>, <%= formatDate(r.date) %>, <%= r.total === null ? '—' : r.total %><% if (r.invalidReason) { %> — причина: <%= r.invalidReason %><% } %>
              <form method="POST" action="<%= base %>/results/<%= r.kind %>/<%= r.rid %>/valid" class="inline"><input type="hidden" name="back" value="<%= base %>/scales" /><button type="submit" class="btn-secondary">Вернуть в динамику</button></form></li>
          <% }) %>
        </ul>
        <p class="hint">Записи не удаляются: они остаются в журнале, но не попадают на график и в экспорт.</p>
      </details>
    <% } %>
  <% } %>
  <p class="result-disclaimer"><%= disclaimer %></p>
</div>
<%- include('../_footer') %>
