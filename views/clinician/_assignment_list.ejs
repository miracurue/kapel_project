<%# Список текущих назначений с отменой. Вход: list, back, showPatient %>
<div class="table-responsive"><table class="stack-mobile assignment-table">
  <thead><tr><% if (showPatient) { %><th>Пациент</th><% } %><th>Методика</th><th>Статус</th><th>Назначено</th><th>Действия</th></tr></thead>
  <tbody>
  <% list.forEach(function(a) { %>
    <tr>
      <% if (showPatient) { %><td><a href="/patients/<%= a.patient_id %>"><%= a.patient_name %></a></td><% } %>
      <td><%- instrumentTag(a.instrument) %><% if (isCatalogStub(a.instrument)) { %> <span class="badge badge-warn">заглушка</span><% } %>
        <% if (a.comment) { %><div class="hint">Пояснение пациенту: <%= a.comment %></div><% } %></td>
      <td>
        <% if (a.status === 'waiting_entry') { %>
          <span class="badge badge-info"><span aria-hidden="true">✎</span> Ожидает ввода врачом</span>
          <div class="hint"><a href="/patients/<%= a.patient_id %>/offline#waiting">Внести протокол</a><% if (a.entry_protocol_id) { %> · есть черновик<% } %></div>
        <% } else { %>
          <span class="badge badge-muted"><span aria-hidden="true">○</span> Ждёт прохождения пациентом</span>
        <% } %>
        <% if (a.due_date) { %><div class="hint">срок: <%= formatDate(a.due_date) %></div><% } %>
        <% if (a.schedule_id) { %><div class="hint">повтор по расписанию</div><% } %>
      </td>
      <td><%= formatDate(String(a.assigned_at).slice(0, 10)) %><% if (a.by_name) { %><div class="hint"><%= a.auto_assigned ? 'автоматически (кризисный протокол)' : a.by_name %></div><% } %></td>
      <td class="row-actions">
        <% if (a.auto_assigned) { %>
          <span class="hint">Назначено автоматически по кризисному протоколу — отменить нельзя; закроется, когда пациент пройдёт тест.</span>
        <% } else { %>
          <form method="POST" action="/assignments/<%= a.id %>/cancel">
            <input type="hidden" name="back" value="<%= back %>" />
            <details><summary>Отменить назначение</summary>
              <label>Причина (необязательно) <input type="text" name="reason" maxlength="200" /></label>
              <button type="submit" class="btn-danger">Подтвердить отмену</button>
            </details>
          </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div>
