<%- include('../_header') %>
<div class="card clinician-card">
  <%- include('_patient_head') %>
  <h2>Журнал</h2>
  <p class="hint">Только чтение: назначения, результаты, эскалации и их подтверждения, обращения и просмотры карточки (кто и когда). Тексты обращений и заметки в журнал не попадают.</p>
  <form method="GET" action="<%= base %>/journal" class="filter-bar">
    <label>Тип
      <select name="type"><option value="">Все</option>
        <% Object.keys(types).forEach(function(k) { %><option value="<%= k %>"<%= type === k ? ' selected' : '' %>><%= types[k] %></option><% }) %>
      </select>
    </label>
    <label>С даты <input type="date" name="from" value="<%= from %>" /></label>
    <label>По дату <input type="date" name="to" value="<%= to %>" /></label>
    <button type="submit" class="btn-secondary">Показать</button>
    <% if (type || from || to) { %><a href="<%= base %>/journal">Сбросить</a><% } %>
  </form>
  <% if (events.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Событий нет</p><p>Необязательно. Записи появятся, когда начнётся работа с пациентом.</p></div>
  <% } else { %>
    <p class="hint">Событий: <%= total %><%= total > events.length ? ' (показаны последние ' + events.length + ')' : '' %>, новые сверху.</p>
    <ul class="pc-journal">
      <% events.forEach(function(e) { %>
        <li><time datetime="<%= String(e.at).replace(' ', 'T') %>"><%= formatDate(e.at) %></time> <span class="badge badge-muted"><%= types[e.type] %></span> <%= e.text %></li>
      <% }) %>
    </ul>
  <% } %>
  <p class="result-disclaimer"><%= disclaimer %></p>
</div>
<%- include('../_footer') %>
