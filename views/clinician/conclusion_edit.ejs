<%- include('../_header') %>
<div class="card clinician-card concl<%= v.status === 'draft' ? ' concl--draft' : '' %>">
  <%- include('_patient_head') %>
  <p><a href="<%= base %>/conclusions">← К заключениям пациента</a> · <a href="/conclusions">Все заключения</a></p>
  <h2><%= v.title || ('Заключение №' + c.id) %>
    <% if (v.status === 'draft') { %><span class="badge badge-warn concl-stamp"><span aria-hidden="true">✎</span> ЧЕРНОВИК</span>
    <% } else { %><span class="badge badge-ok"><span aria-hidden="true">✔</span> подписано</span><% } %>
    <span class="hint">версия <%= v.version %><%= isLatest ? '' : ' (не последняя)' %> · автор <%= authorName %></span>
  </h2>
  <p class="notice-honest" role="note"><%= signNotice %> Структура разделов — заглушка (review-required). Автоматических диагностических формулировок нет; текст целиком ваш.</p>
  <% if (!mine) { %><p class="hint">Только чтение. <%= v.status === 'draft' ? 'Черновик психолога, не подписано.' : 'Заключение подписал психолог-автор.' %> Править, подписывать и выдавать его может только автор-психолог.</p><% } %>
  <% if (v.reason) { %><p class="hint">Причина этой версии: <%= v.reason %></p><% } %>

  <% if (v.status === 'signed') { %>
    <section class="concl-signbox" aria-label="Сведения о подписи">
      <p><strong>Подписано:</strong> <%= v.signed_name %>, <%= v.signed_at %> (UTC), способ: <%= v.sign_method === 'password' ? 'повторный пароль' : 'ФИО и подтверждение' %>.</p>
      <p><strong>Контрольная сумма версии (SHA-256):</strong> <code class="concl-hash"><%= v.checksum %></code></p>
      <p><%= integrity ? 'Целостность: текст версии совпадает с контрольной суммой.' : 'ВНИМАНИЕ: текст версии не совпадает с контрольной суммой.' %></p>
      <p class="hint"><%= signNotice %> Текст заблокирован.</p>
    </section>
  <% } %>

  <% if (editable) { %>
  <form method="POST" action="/conclusions/<%= c.id %>" class="concl-form" data-autosave="/conclusions/<%= c.id %>">
    <label>Название (необязательно) <input type="text" name="title" maxlength="200" value="<%= v.title || '' %>" /></label>
    <% sections.forEach(function(s) { %>
      <div class="concl-section">
        <label for="f-<%= s.key %>"><%= s.label %> <span class="tag tag-optional">необязательно</span></label>
        <p class="hint"><%= s.hint %></p>
        <textarea id="f-<%= s.key %>" name="<%= s.key %>" rows="<%= s.key === 'protocols' ? 7 : 5 %>" maxlength="20000"><%= v.sections[s.key] %></textarea>
      </div>
    <% }) %>
    <p><button type="submit">Сохранить черновик</button> <span class="hint" id="autosave-state" role="status">Автосохранение включится при наборе текста (если включён JavaScript).</span></p>
  </form>
  <form method="POST" action="/conclusions/<%= c.id %>/refill" class="inline">
    <button type="submit" class="btn-secondary">Подставить протоколы заново (<%= protocolsNow %>)</button>
    <span class="hint">заменит текст раздела о методиках</span>
  </form>
  <% } else { %>
    <% sections.forEach(function(s) { %>
      <div class="concl-section">
        <h3><%= s.label %></h3>
        <div class="pc-note__body"><%= v.sections[s.key] || '—' %></div>
      </div>
    <% }) %>
  <% } %>

  <% if (canSign) { %>
  <section class="pc-section" id="sign" aria-labelledby="sign-h">
    <h3 id="sign-h">Подписать</h3>
    <p class="hint">После подписи текст версии блокируется. Подтвердите повторным паролем <em>или</em> введите ФИО и отметьте флажок. <%= signNotice %></p>
    <form method="POST" action="/conclusions/<%= c.id %>/sign" class="concl-sign">
      <label>Пароль <input type="password" name="confirm_password" autocomplete="current-password" /></label>
      <p class="hint">— или —</p>
      <label>ФИО как в профиле <input type="text" name="confirm_name" autocomplete="off" /></label>
      <label class="pc-check"><input type="checkbox" name="confirm_check" value="1" /> Проверил(а) и подтверждаю</label>
      <button type="submit">Подписать заключение</button>
    </form>
  </section>
  <% } %>

  <% if (canRevise) { %>
  <section class="pc-section" id="revise" aria-labelledby="rev-h">
    <h3 id="rev-h">Внести правку</h3>
    <p class="hint">Подписанный текст не изменяется. Правка создаёт новую версию-черновик; предыдущие версии сохраняются. Причина обязательна для новой версии.</p>
    <form method="POST" action="/conclusions/<%= c.id %>/revise" class="filter-bar">
      <label>Причина правки <input type="text" name="reason" maxlength="1000" /></label>
      <button type="submit" class="btn-secondary">Создать новую версию</button>
    </form>
  </section>
  <% } %>

  <section class="pc-section" aria-labelledby="exp-h">
    <h3 id="exp-h">Экспорт для переноса в МИС</h3>
    <p>
      <a class="btn btn-secondary" href="/conclusions/<%= c.id %>/export.docx?v=<%= v.version %>">DOCX</a>
      <a class="btn btn-secondary" href="/conclusions/<%= c.id %>/export.pdf?v=<%= v.version %>">PDF</a>
      <a class="btn btn-secondary" href="/conclusions/<%= c.id %>/export.txt?v=<%= v.version %>">TXT</a>
    </p>
    <p class="hint"><%= v.status === 'draft' ? 'Неподписанная версия экспортируется с отметкой «ЧЕРНОВИК». ' : '' %>Имя файла без ФИО; экспорт записывается в журнал доступа.</p>
  </section>

  <% if (canRelease) { %>
  <section class="pc-section" aria-labelledby="rel-h">
    <h3 id="rel-h">Пациенту</h3>
    <p class="hint">По умолчанию пациент заключение не видит. Решение о выдаче принимаете вы; выдаётся последняя подписанная версия. Новая правка снимает выдачу.</p>
    <form method="POST" action="/conclusions/<%= c.id %>/release" class="inline">
      <input type="hidden" name="release" value="<%= c.released_to_patient ? '0' : '1' %>" />
      <button type="submit" class="btn-secondary"><%= c.released_to_patient ? 'Отозвать выдачу пациенту' : 'Выдать пациенту' %></button>
      <span class="hint"><%= c.released_to_patient ? 'Сейчас выдано (' + c.released_at + ')' : 'Сейчас не выдано' %></span>
    </form>
  </section>
  <% } %>

  <section class="pc-section" aria-labelledby="hist-h">
    <h3 id="hist-h">История версий</h3>
    <ul class="pc-journal">
      <% history.forEach(function(h) { if (!seesDraft && h.status !== 'signed') return; %>
        <li>
          <a href="/conclusions/<%= c.id %>/versions/<%= h.version %>">Версия <%= h.version %></a>
          — <%= h.status === 'signed' ? 'подписана ' + h.signed_at + ', ' + h.signed_name : 'черновик' %>
          <% if (h.checksum) { %><span class="hint">· SHA-256 <code><%= h.checksum.slice(0, 12) %>…</code></span><% } %>
          <% if (h.reason) { %><span class="hint">· причина: <%= h.reason %></span><% } %>
        </li>
      <% }) %>
    </ul>
  </section>

  <% if (editable) { %>
  <section class="pc-section" aria-labelledby="rem-h">
    <h3 id="rem-h">Напоминания по структуре</h3>
    <ul><% reminders.forEach(function(t) { %><li><%= t %></li><% }) %></ul>
    <p class="hint">Это только напоминания, не содержание заключения.</p>
  </section>
  <% } %>
  <p class="result-disclaimer"><%= disclaimer %></p>
</div>
<script src="/conclusions.js" defer></script>
<%- include('../_footer') %>
