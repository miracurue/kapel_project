<p class="print-only print-banner">Демо · справка, не заключение · черновик</p>
<%# Шапка карточки: ФИО, светофор, согласие, архив, вкладки. Вход: patient, verdict, tags, alsoWith, archived, consentOk, consentReason, tabs, tab, base %>
<div class="pc-head">
  <h1><%= patient.full_name %></h1>
  <div class="pc-head__meta">
    <% if (verdict) { %><%- include('_verdict', { p: { verdict: verdict } }) %><% } %>
    <% if (archived) { %><span class="badge badge-muted">архив: наблюдение завершено</span><% } %>
    <% if (!consentOk) { %><span class="badge badge-warn">нет согласия на передачу данных врачу</span><% } %>
    <% tags.forEach(function(t) { %><span class="tag tag-optional"><%= t %></span><% }) %>
  </div>
  <% if (verdict) { %><p class="hint pc-why"><%= verdict.oneLine %></p><% } %>
  <% if (alsoWith.length) { %><p class="hint">также ведёт: <%= alsoWith.map(function(c) { return c.full_name; }).join(', ') %> (назначения и результаты общие, заметки приватны)</p><% } %>
  <% if (!consentOk) { %><p class="notice-honest" role="note"><%= consentReason %> Данные пациента (онлайн-результаты, дневник) врачу не передаются; открытые эскалации остаются видны. Новые назначения невозможны.</p><% } %>
  <% if (archived) { %>
    <form method="POST" action="/patients/<%= patient.id %>/unarchive" class="inline">
      <input type="hidden" name="back" value="<%= base %>" />
      <button type="submit" class="btn-secondary">Вернуть из архива</button>
    </form>
  <% } %>
</div>
<nav class="tabs pc-tabs" aria-label="Разделы карточки пациента">
  <% tabs.forEach(function(t) { %>
    <a class="tabs__tab<%= tab === t.key ? ' is-active' : '' %>" href="<%= base + t.path %>"<%- tab === t.key ? ' aria-current="page"' : '' %>><%= t.label %></a>
  <% }) %>
</nav>
<p class="hint pc-care-links">Ещё: <a href="<%= base %>/messages">Сообщения<%= (typeof carePatientUnread !== 'undefined' && carePatientUnread > 0) ? ' (' + carePatientUnread + ' новых)' : '' %></a> · <a href="<%= base %>/learn">Модули и опросник</a></p>
