<%- include('_header') %>
<div class="card" data-session-lost>
  <h1>Вход</h1>
  <form method="POST" action="/login">
    <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required autocomplete="username" />
    <label for="password">Пароль</label>
    <input type="password" id="password" name="password" required autocomplete="current-password" />
    <p><button type="submit">Войти</button></p>
  </form>
  <p class="hint">Забыли пароль? Обратитесь к вашему врачу или в администрацию сервиса: временный пароль выдаёт администратор.</p>
  <p>Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>
  <p class="muted">Запрашивали удаление данных и передумали? <a href="/account/cancel-deletion">Отменить запрос на удаление</a></p>
</div>
<%- include('_footer') %>
