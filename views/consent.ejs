<%- include('_header') %>
<div class="card">
  <h1>Текст согласий</h1>
  <p class="muted">Версия: <%= consentVersion %>. Тексты согласий в этой версии не менялись.</p>
  <% Object.keys(consentParts).forEach(function(k) { var part = consentParts[k]; %>
    <h2><%= part.required ? 'Обязательное согласие' : 'Необязательное согласие' %></h2>
    <p><%= part.checkboxLabel %></p>
    <p><%= part.full %></p>
  <% }) %>
  <p><a href="/register">&larr; К регистрации</a> · <a href="/login">Вход</a></p>
</div>
<%- include('_footer') %>
