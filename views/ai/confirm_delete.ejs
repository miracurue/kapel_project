<%- include('../_header') %>
<div class="card ai-confirm">
  <h1>Удалить диалог?</h1>
  <p><strong><%= thread.title %></strong></p>
  <p><%= note %></p>
  <form method="POST" action="<%= base %>/t/<%= thread.id %>/delete" class="ai-confirm__actions">
    <button type="submit" class="btn-danger">Да, удалить диалог</button>
    <a class="ai-link" href="<%= base %>/t/<%= thread.id %>">Отмена</a>
  </form>
</div>
<%- include('../_footer') %>
