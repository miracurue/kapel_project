<%# Сценарии-подсказки (REQ-AID-004) и панель маскирования вставленного текста (REQ-AID-018). %>
<div class="ws-scenarios<%= messages.length ? ' is-compact' : '' %>" id="ws-scenarios" role="group" aria-label="Сценарии">
  <% ws.scenarios.forEach(function(sc) { %>
    <form method="POST" action="<%= base %>/send" class="ws-scn-form" data-scenario="<%= sc.key %>">
      <input type="hidden" name="thread_id" value="<%= thread ? thread.id : '' %>" />
      <input type="hidden" name="scenario" value="<%= sc.key %>" />
      <% if (sc.period) { %>
        <label class="visually-hidden" for="ws-period">Период</label>
        <select id="ws-period" name="period" class="ws-period" title="Период для сценария «динамика»">
          <option value="">за всё время</option>
          <% ws.periods.forEach(function(p) { %><option value="<%= p.days %>"><%= p.label %></option><% }) %>
        </select>
      <% } %>
      <button type="submit" class="ws-scn" title="<%= sc.hint %><%= sc.needsPatient && !ws.patient ? ' Нужен привязанный пациент.' : '' %>"><%= sc.title %><% if (sc.needsPatient && !ws.patient) { %> <span class="ws-needp">нужен пациент</span><% } %></button>
    </form>
  <% }) %>
</div>
<div class="ws-pii" id="ws-pii" hidden role="region" aria-label="Персональные данные в тексте">
  <p><strong>В тексте найдены возможные персональные данные</strong> (<span id="ws-pii-types"></span>). Замаскировать их перед отправкой?</p>
  <div class="ws-pii__cols">
    <div><span class="ws-pii__h">Сейчас</span><div class="ws-pii__box" id="ws-pii-before"></div></div>
    <div><span class="ws-pii__h">После маскирования</span><div class="ws-pii__box" id="ws-pii-after"></div></div>
  </div>
  <p class="ws-hint">Маскирование не даёт гарантии полного обезличивания — проверьте результат.</p>
  <div class="ws-pii__actions">
    <button type="button" class="ws-pii-yes" id="ws-pii-yes">Замаскировать</button>
    <button type="button" class="btn-secondary ws-pii-no" id="ws-pii-no">Оставить как есть</button>
  </div>
</div>
