<%- include('../../_header') %>
<div class="card ws-preview">
  <h1>Проверьте материал перед сохранением</h1>
  <p>Текст извлечён локально, файл никуда не передавался. Пока вы не нажмёте «Сохранить», ничего не записано.</p>

  <% if (rejected.length) { %>
    <div class="flash flash-error" role="alert">
      <strong>Не принято:</strong>
      <ul class="ws-rej"><% rejected.forEach(function(r) { %><li><%= r.message %></li><% }) %></ul>
    </div>
  <% } %>

  <% if (items.length === 0) { %>
    <p><a class="ai-link" href="<%= threadId ? base + '/t/' + threadId : base %>">Вернуться в ИИ-пространство</a></p>
  <% } else { %>
    <form method="POST" action="<%= base %>/materials/recheck" class="ws-recheck">
      <input type="hidden" name="token" value="<%= token %>" />
      <label class="ws-check"><input type="checkbox" name="mask" value="1"<%- mask ? ' checked' : '' %> /> Автоматически замаскировать персональные данные</label>
      <button type="submit" class="btn-secondary">Применить</button>
      <span class="ws-hint">Маскирование не даёт гарантии полного обезличивания.</span>
    </form>

    <form method="POST" action="<%= base %>/materials/save" id="ws-save-form">
      <input type="hidden" name="token" value="<%= token %>" />
      <input type="hidden" name="mask" value="<%= mask ? '1' : '0' %>" />
      <input type="hidden" name="thread_id" value="<%= threadId || '' %>" />
      <% items.forEach(function(it) { %>
        <section class="ws-prev-item">
          <h2><%= it.name %> <span class="ws-mat__meta">(<%= it.kind %>, <%= Math.max(1, Math.round(it.size / 1024)) %> КБ)</span></h2>
          <% if (it.note) { %><p class="ws-hint"><%= it.note %></p><% } %>
          <% if (!it.hasText) { %>
            <p>Текст из этого файла не извлечён, он будет сохранён как файл.</p>
          <% } else if (it.masked) { %>
            <% if (it.matches.length === 0) { %>
              <p class="ws-ok">Персональные данные не найдены (проверка эвристическая — просмотрите текст сами).</p>
            <% } else { %>
              <p><strong>Найдено замен: <%= it.matches.length %>.</strong> Отметьте «оставить», если это не персональные данные.</p>
              <ul class="ws-rep-list">
                <% it.matches.forEach(function(m) { %>
                  <li><label><input type="checkbox" class="ws-keep" name="keep" value="<%= it.i %>:<%= m.id %>" data-rep="r<%= it.i %>-<%= m.id %>" /> оставить «<%= m.value %>» <span class="ws-mat__meta">(<%= m.title %> → <%= m.label %>)</span></label></li>
                <% }) %>
              </ul>
            <% } %>
            <div class="ws-ba">
              <div><span class="ws-pii__h">До</span>
                <div class="ws-pii__box"><% it.segs.forEach(function(s) { %><% if (s.match) { %><mark><%= s.text %></mark><% } else { %><%= s.text %><% } %><% }) %><%= it.truncated ? ' …' : '' %></div></div>
              <div><span class="ws-pii__h">После (так будет сохранено)</span>
                <div class="ws-pii__box"><% it.segs.forEach(function(s) { %><% if (s.match) { %><span class="ws-rep" id="r<%= it.i %>-<%= s.match.id %>" data-label="<%= s.match.label %>" data-orig="<%= s.text %>"><%= s.match.label %></span><% } else { %><%= s.text %><% } %><% }) %><%= it.truncated ? ' …' : '' %></div></div>
            </div>
            <p class="ws-hint">Оригинал не сохраняется: на диске и в базе остаётся только текст «после».</p>
          <% } else { %>
            <p class="ws-warn"><strong>Маскирование выключено:</strong> файл и текст будут сохранены как есть, вместе с персональными данными (если они есть).</p>
            <pre class="ws-prev-pre"><%= it.preview %><%= it.truncated ? '\n…' : '' %></pre>
          <% } %>
        </section>
      <% }) %>
      <div class="ai-confirm__actions">
        <button type="submit">Сохранить в диалог</button>
        <button type="submit" formaction="<%= base %>/materials/cancel" class="btn-secondary">Отмена</button>
      </div>
      <p class="ws-hint">Срок хранения — 30 дней, удалить материал можно в любой момент.</p>
    </form>
  <% } %>
</div>
<script src="/workspace.js" defer></script>
<%- include('../../_footer') %>
