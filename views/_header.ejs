<!DOCTYPE html>
<% var isPatient = !!(user && user.role === 'patient'); var pf = (typeof prefs !== 'undefined' && prefs) ? prefs : null; %>
<html lang="ru"<% if (isPatient && pf) { %> data-theme="<%= pf.theme %>"<% if (pf.large_font) { %> data-fs="large"<% } %><% } %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= (typeof title !== 'undefined' && title) ? title + ' — ' : (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' — ' : '' %><%= (typeof crisisOpenCount !== 'undefined' && crisisOpenCount > 0) ? '(' + crisisOpenCount + ') ' : '' %>ТДР — помощник врача</title>
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <link rel="stylesheet" href="/style.css" />
  <script src="/csrf.js" defer></script>
  <script src="/form_keeper.js" defer></script>
</head>
<body<%- isPatient ? ' class="patient"' : '' %>>
  <a class="skip-link" href="#main-content">Перейти к содержимому</a>
  <header class="topbar">
    <% if (user) { %>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-controls="sidenav" aria-expanded="true" aria-label="Меню">&#9776; Меню</button>
    <% } %>
    <a href="/dashboard" class="brand">ТДР MVP</a>
    <%# Экстренная помощь — постоянно видима на каждой странице, для любой роли и для гостей. %>
    <a class="topbar-emergency" href="tel:112">Экстренная помощь: 112</a>
    <% if (isPatient) { %><a id="help-now" class="help-now" href="/help" aria-label="Мне плохо — открыть экран помощи">Мне плохо</a><% } %>
    <% if (user) { %>
      <span class="who"><%= user.full_name %> (<%= ({ patient: 'пациент', psychiatrist: 'психиатр', psychologist: 'психолог', admin: 'администратор' })[user.role] || user.role %>)</span>
      <% if (user.role === 'psychiatrist' || user.role === 'psychologist') { %><a href="/crisis">Кризисная очередь<% if (typeof crisisOpenCount !== 'undefined' && crisisOpenCount > 0) { %> (<%= crisisOpenCount %>)<% } %></a><% } %>
      <form method="POST" action="/logout" class="inline-form"><button type="submit">Выйти</button></form>
    <% } %>
  </header>
  <details class="demo-banner" open>
    <summary>Демо-версия: данные вымышленные, тесты — заглушки, не клинически валидны</summary>
    <p>Сервис не предназначен для клинического использования: результаты не являются диагнозом или назначением, решение всегда за врачом.</p>
  </details>
  <div class="app-shell<%= user ? ' has-sidenav' : '' %>">
    <% if (user) { %>
      <nav class="sidenav" id="sidenav" aria-label="Основное меню">
        <ul class="sidenav__list">
          <% navItems.forEach(function(item) { %>
            <li>
              <% if (item.soon) { %>
                <span class="sidenav__item is-disabled" aria-disabled="true"><%= item.label %> <span class="badge badge-soon">скоро</span></span>
              <% } else { %>
                <a class="sidenav__item<%= item.active ? ' is-active' : '' %>" href="<%= item.href %>"<% if (item.active) { %> aria-current="page"<% } %>><%= item.label %><% if (item.badge && locals[item.badge] > 0) { %> <span class="badge <%= item.badgeClass || 'badge-risk' %>" aria-label="<%= item.badgeClass ? 'новых: ' : 'требует решения: ' %><%= locals[item.badge] %>"><%= locals[item.badge] %></span><% } %><% if (item.key === 'crisis' && typeof crisisOpenCount !== 'undefined' && crisisOpenCount > 0) { %> <span class="badge badge-risk" aria-label="открытых: <%= crisisOpenCount %>"><%= crisisOpenCount %></span><% } %></a>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </nav>
    <% } %>
  <main class="container" id="main-content" tabindex="-1">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.kind %>" role="<%= flash.kind === 'error' ? 'alert' : 'status' %>"><span class="flash__icon" aria-hidden="true"><%= flash.kind === 'error' ? '!' : (flash.kind === 'success' ? '✓' : 'i') %></span><span><%= flash.message %></span></div>
    <% } %>
    <% if (isPatient && typeof showSupport !== 'undefined' && showSupport) { %><%- include('patient/_support') %><% } %>
