<%- include('../_header') %>

<div class="card">
  <h1>Здравствуйте, <%= fullName %></h1>
  <% if (returning) { %>
    <p class="lead"><%= text.WELCOME_BACK %></p>
  <% } %>
</div>

<% if (careNotice) { %>
  <div class="card notice" id="care-notice" role="status">
    <h2><%= careNotice === 'ended' ? 'Наблюдение завершено' : 'Ваш врач изменился' %></h2>
    <p><%= text.DOCTOR_CHANGED_NOW %></p>
    <form method="POST" action="/care-notice/dismiss"><button type="submit" class="btn-secondary">Понятно</button></form>
  </div>
<% } %>

<% if (!linked) { %>
  <div class="card" id="link-doctor">
    <h2>Связь с врачом</h2>
    <p><%= wasLinked ? text.DOCTOR_CHANGED : text.DOCTOR_NONE %></p>
    <form method="POST" action="/link-code" class="inline-form">
      <label for="code">Код от врача</label>
      <input type="text" id="code" name="code" autocomplete="off" autocapitalize="characters" maxlength="40" required />
      <button type="submit">Привязаться</button>
    </form>
    <p class="muted">Код выдаёт врач. Пока вы не привязаны, экстренная помощь и ИИ-помощник остаются доступными.</p>
  </div>
<% } %>

<% if (cards.length === 0) { %>
  <div class="card empty-state">
    <p class="empty-state__title"><%= text.NOTHING_TODAY %></p>
    <p>Если захочется, можно записать настроение или просто заглянуть в чат.</p>
    <p><a class="btn-link" href="/diary">Открыть дневник</a></p>
  </div>
<% } else { %>
  <% cards.forEach(function(c) { %>
    <% if (c.kind === 'test') { %>
      <div class="card today-card">
        <h2>Тест от врача</h2>
        <p><strong><%- instrumentTag(c.data.instrument) %></strong> · <%= c.data.ins.items.length %> вопросов, около <%= Math.max(1, Math.ceil(c.data.ins.items.length / 4)) %> мин.</p>
        <p><a class="btn-link btn-link--primary" href="/assignments/<%= c.data.id %>/take"><%= c.data.hasDraft ? 'Продолжить' : 'Пройти' %></a>
          <% if (c.data.more > 0) { %><a class="btn-link" href="/tests">Ещё назначений: <%= c.data.more %></a><% } %></p>
      </div>
    <% } else if (c.kind === 'reminder') { %>
      <div class="card today-card">
        <h2>Напоминание</h2>
        <p><%= c.data.message %> <span class="badge badge-info"><%= c.due ? 'пора' : 'сегодня, ' + formatDate(c.data.remind_at).slice(-5) %></span></p>
        <form method="POST" action="/reminders/<%= c.data.id %>/done">
          <input type="hidden" name="back" value="/dashboard" />
          <button type="submit">Готово</button>
          <a class="btn-link" href="/reminders">Все напоминания</a>
        </form>
      </div>
    <% } else if (c.kind === 'care') { %>
      <div class="card today-card">
        <h2><%= c.title %></h2>
        <p><%= c.text %></p>
        <p><a class="btn-link btn-link--primary" href="<%= c.href %>"><%= c.cta %></a></p>
      </div>
    <% } else if (c.kind === 'diary') { %>
      <div class="card today-card">
        <h2>Как вы сегодня?</h2>
        <p>Одна оценка настроения занимает несколько секунд. Остальное — по желанию.</p>
        <p><a class="btn-link btn-link--primary" href="/diary">Записать настроение</a></p>
      </div>
    <% } %>
  <% }) %>
<% } %>

<% if (returning && pendingCount > 0 && cards.every(function(c) { return c.kind !== 'test'; })) { %>
  <div class="card quiet" id="pending-tests">
    <p>Назначено врачом: <strong><%= pendingCount %></strong>. Когда будет удобно — <a href="/tests">откройте «Тесты»</a>, спешить не нужно.</p>
  </div>
<% } %>

<% if (missedCount > 0) { %>
  <details class="card quiet" id="missed">
    <summary>Пропущено ранее: <%= missedCount %></summary>
    <p>Эти напоминания можно не выполнять. Можно убрать их из списка.</p>
    <form method="POST" action="/reminders/clear-missed">
      <input type="hidden" name="back" value="/dashboard" />
      <button type="submit" class="btn-secondary">Очистить</button>
    </form>
  </details>
<% } %>

<%- include('../_footer') %>
