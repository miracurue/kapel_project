<%- include('../_header') %>
<%- include('_back', { backHref: '/dashboard', backLabel: 'На главную' }) %>

<div class="card">
  <h1>Профиль</h1>
  <p class="muted">Вы вошли как <%= user.full_name %> (<%= email %>)</p>
</div>

<div class="card" id="phone">
  <h2>Телефон для срочной связи (необязательно)</h2>
  <p class="muted">Если указать, врач увидит номер в вашей карточке. Заполнять не нужно.</p>
  <form method="POST" action="/profile/phone">
    <label for="phone_input">Телефон</label>
    <input type="tel" id="phone_input" name="phone" value="<%= phone %>" autocomplete="tel" maxlength="30" />
    <p><button type="submit">Сохранить</button></p>
  </form>
</div>

<div class="card" id="appearance">
  <h2>Оформление</h2>
  <form method="POST" action="/profile/appearance">
    <label for="theme">Тема</label>
    <select id="theme" name="theme">
      <option value="auto"<%= prefs.theme === 'auto' ? ' selected' : '' %>>Как в системе</option>
      <option value="light"<%= prefs.theme === 'light' ? ' selected' : '' %>>Светлая</option>
      <option value="dark"<%= prefs.theme === 'dark' ? ' selected' : '' %>>Тёмная</option>
    </select>
    <label class="check-row"><input type="checkbox" name="large_font" value="1"<%= prefs.large_font ? ' checked' : '' %> /> Крупный шрифт</label>
    <p><button type="submit">Сохранить</button></p>
  </form>
</div>

<div class="card" id="password">
  <h2>Смена пароля</h2>
  <form method="POST" action="/profile/password">
    <label for="current_password">Текущий пароль</label>
    <input type="password" id="current_password" name="current_password" autocomplete="current-password" required />
    <label for="new_password">Новый пароль (не короче 8 символов)</label>
    <input type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="8" required />
    <label for="new_password2">Повторите новый пароль</label>
    <input type="password" id="new_password2" name="new_password2" autocomplete="new-password" minlength="8" required />
    <p class="muted">После смены пароля на других устройствах нужно будет войти заново.</p>
    <p><button type="submit">Сменить пароль</button></p>
  </form>
</div>

<div class="card">
  <form method="POST" action="/logout"><button type="submit" class="btn-secondary">Выйти</button></form>
</div>
<%- include('../_footer') %>
