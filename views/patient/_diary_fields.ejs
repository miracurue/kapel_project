<%# Общие поля записи дневника. Параметры: form, prefs. %>
<fieldset class="mood-scale">
  <legend>Настроение сейчас: 1 — очень тяжело, 10 — очень хорошо</legend>
  <div class="mood-scale__row">
    <% for (var n = 1; n <= 10; n++) { %>
      <label class="mood-btn"><input type="radio" name="mood_score" value="<%= n %>"<%= String(form.mood_score) === String(n) ? ' checked' : '' %> required /><span><%= n %></span></label>
    <% } %>
  </div>
</fieldset>

<details class="optional"<%= (form.note || form.triggers || form.sleep_hours !== '' || form.anxiety !== '' || (form.entry_date && form.entry_date !== todayValue)) ? ' open' : '' %>>
  <summary>Добавить подробности (необязательно)</summary>
  <label for="entry_date">Дата записи</label>
  <input type="date" id="entry_date" name="entry_date" value="<%= form.entry_date %>" max="<%= todayValue %>" />
  <label for="sleep_hours">Сон, часов (необязательно)</label>
  <input type="text" inputmode="decimal" id="sleep_hours" name="sleep_hours" value="<%= form.sleep_hours %>" size="4" />
  <label for="anxiety">Тревога, от 1 до 10 (необязательно)</label>
  <input type="number" id="anxiety" name="anxiety" min="1" max="10" value="<%= form.anxiety %>" />
  <label for="triggers">Что повлияло (необязательно)</label>
  <input type="text" id="triggers" name="triggers" maxlength="500" value="<%= form.triggers %>" />
  <label for="note">Заметка (необязательно)</label>
  <textarea id="note" name="note" rows="3" maxlength="4000" data-draft-key="diary-note"><%= form.note %></textarea>
</details>

<p class="visibility" id="visibility">Врач видит:
  <%= prefs.share_diary_scores ? 'оценку настроения' : 'ничего из дневника (вы не делитесь оценками)' %>;
  <%= prefs.share_diary_notes ? 'заметку' : 'не видит заметку' %>.
  <a href="/share">Изменить</a></p>
