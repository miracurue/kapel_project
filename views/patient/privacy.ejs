<%- include('../_header') %>
<%- include('_back', { backHref: '/dashboard', backLabel: 'На главную' }) %>

<div class="card" id="consents">
  <h1>Приватность</h1>
  <h2>Ваши согласия</h2>
  <ul class="plain-list">
    <li class="item-card"><strong>Обработка персональных данных и данных о здоровье</strong><br />
      <%= consent.consent_given ? 'дано, ' + formatDate(consent.consent_at) : 'не дано' %></li>
    <li class="item-card"><strong>Использование результатов врачом для наблюдения</strong><br />
      <%= consent.clinical_consent_given ? 'дано, ' + formatDate(consent.clinical_consent_at) : 'не дано' %></li>
    <li class="item-card"><strong>Научное использование обезличенных данных</strong> (необязательно)<br />
      <% if (consent.anonymized_export_opt_in && !consent.export_consent_revoked_at) { %>дано при регистрации, <%= formatDate(consent.consent_at) %>
      <% } else if (consent.export_consent_revoked_at) { %>отозвано, <%= formatDate(consent.export_consent_revoked_at) %>
      <% } else { %>не дано<% } %></li>
  </ul>
  <p class="muted">Версия текста согласия: <%= CONSENT_VERSION %> · <a href="/consent">прочитать полностью</a></p>
  <% if (consent.anonymized_export_opt_in && !consent.export_consent_revoked_at) { %>
    <details class="confirm-inline">
      <summary class="btn-secondary">Отозвать согласие на научное использование</summary>
      <form method="POST" action="/account/export-consent/revoke">
        <p>Ваши данные сразу перестанут попадать в обезличенную научную выгрузку. Это не влияет на лечение и работу кабинета.</p>
        <button type="submit" class="btn-secondary">Да, отозвать</button>
      </form>
    </details>
  <% } %>
</div>

<div class="card" id="viewers">
  <h2>Кто смотрел мои данные</h2>
  <% if (views.length === 0) { %>
    <div class="empty-state"><p class="empty-state__title">Просмотров пока не было</p><p>Здесь появятся записи о том, когда специалист открывал ваши данные. Содержимое не показывается.</p></div>
  <% } else { %>
    <div class="table-responsive"><table>
      <tr><th>Когда</th><th>Кто</th><th>Что</th></tr>
      <% views.forEach(function(v) { %><tr><td><%= formatDate(v.when) %></td><td><%= v.role %></td><td><%= v.action %><% if (v.count > 1) { %> · раз: <%= v.count %><% } %></td></tr><% }) %>
    </table></div>
  <% } %>
</div>

<div class="card" id="download">
  <h2>Скачать мои данные</h2>
  <p>Только ваши данные: результаты, дневник, напоминания, переписка с помощником.</p>
  <p class="actions"><a class="btn-link" href="/account/export.json" download>Скачать JSON</a> <a class="btn-link" href="/account/export.csv" download>Скачать CSV</a></p>
</div>

<div class="card">
  <h2>Помощь и знакомство с сервисом</h2>
  <p><a href="/onboarding?step=1">Показать вводные экраны ещё раз</a></p>
</div>

<div class="card" id="delete">
  <h2>Удаление данных</h2>
  <p>Можно отозвать согласие и попросить удалить данные. Подробности и последствия — на следующем шаге, ничего не произойдёт сразу.</p>
  <p><a class="btn-link" href="/privacy/delete">Перейти к запросу на удаление</a></p>
</div>
<%- include('../_footer') %>
