<%- include('../_header') %>
<%
  var slides = [
    { h: 'Что это за сервис', p: 'Это помощник вашего врача: тесты, дневник настроения и напоминания в одном месте. Сервис не ставит диагноз и не заменяет приём. Всё необязательное можно пропускать. [текст-заглушка, ждёт ревью]' },
    { h: 'Что видит врач', p: 'Результаты назначенных тестов видит ваш врач. Оценки дневника он видит по умолчанию, а заметки — только если вы сами разрешите. Это можно менять в разделе «Поделиться с врачом». [текст-заглушка, ждёт ревью]' },
    { h: 'Как позвать помощь', p: 'Кнопка «Мне плохо» всегда в верхней части страницы. Она ведёт к номеру 112 и к возможности сообщить врачу. Сервис не следит за вами круглосуточно, поэтому при срочной опасности звоните 112. [текст-заглушка, ждёт ревью]' }
  ];
  var s = slides[step - 1];
%>
<div class="card">
  <p class="muted">Шаг <%= step %> из 3</p>
  <h1><%= s.h %></h1>
  <p class="lead"><%= s.p %></p>
  <div class="actions">
    <% if (step > 1) { %><a class="btn-link" href="/onboarding?step=<%= step - 1 %>">Назад</a><% } %>
    <% if (step < 3) { %><a class="btn-link btn-link--primary" href="/onboarding?step=<%= step + 1 %>">Дальше</a>
    <% } else { %>
      <form method="POST" action="/onboarding" class="inline"><button type="submit">Начать</button></form>
    <% } %>
  </div>
  <% if (pending) { %>
    <form method="POST" action="/onboarding"><button type="submit" class="btn-secondary">Пропустить</button></form>
  <% } else { %>
    <p><a href="/privacy">&larr; Назад в «Приватность»</a></p>
  <% } %>
</div>
<%- include('../_footer') %>
