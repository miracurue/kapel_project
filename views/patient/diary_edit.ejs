<%- include('../_header') %>
<%- include('_back', { backHref: '/diary', backLabel: 'К дневнику' }) %>
<div class="card">
  <h1>Изменить запись</h1>
  <% if (formError) { %><p class="flash flash-error" role="alert" data-form-error><%= formError %></p><% } %>
  <form method="POST" action="/diary/<%= entry.id %>/edit">
    <%- include('_diary_fields', { form: form, prefs: prefs, todayValue: todayValue }) %>
    <p><button type="submit">Сохранить</button> <a class="btn-link" href="/diary">Отмена</a></p>
  </form>
</div>
<%- include('../_footer') %>
