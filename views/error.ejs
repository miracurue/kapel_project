<%
  var code = (typeof status !== 'undefined' && status) ? status : 500;
  var lost = (typeof sessionLost !== 'undefined' && sessionLost);
  var heading = lost ? 'Сессия истекла' : ({ 403: 'Нет доступа', 404: 'Страница не найдена', 500: 'Что-то пошло не так' })[code] || 'Ошибка';
  var pageTitle = heading;
%>
<%- include('_header') %>
<div class="card error-page"<%- lost ? ' data-session-lost' : '' %>>
  <h1><%= heading %></h1>
  <p><%= message %></p>
  <% if (lost) { %>
  <p>Введённый текст сохранён на этом устройстве: после входа вы вернётесь на эту страницу и сможете его восстановить.</p>
  <p class="error-actions"><a class="btn" href="/login<%= typeof loginNext !== 'undefined' && loginNext ? '?next=' + encodeURIComponent(loginNext) : '' %>">Войти и вернуться</a></p>
  <% } else { %>
  <p class="error-actions"><a class="btn" href="<%= user ? '/dashboard' : '/login' %>"><%= user ? 'На главную' : 'Ко входу' %></a></p>
  <% } %>
</div>
<%- include('_footer') %>
