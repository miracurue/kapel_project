NODE_ENV=development
PORT=3000
DATA_MODE=synthetic
DEMO_MODE=1
DB_PATH=data/tdr.sqlite3
DATA_DIR=data
PUBLIC_BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=
SECRETS_MASTER_KEY=
PII_ENC_KEY=
PII_HMAC_KEY=
CLINICAL_ENC_KEY=
TOTP_ENC_KEY=
LOG_HMAC_KEY=
RESEARCH_HMAC_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=0
MAIL_FROM=noreply@cc.example.test
ML_WORKER_URL=http://127.0.0.1:8090
ML_WORKER_TOKEN=
FILE_SCANNER=none
# Внешняя модель GigaChat (только синтетические данные, DATA_MODE=synthetic). Ключ авторизации из кабинета разработчика
# Сбера (base64 от «Client ID:Client Secret»), не Client ID. Пусто — работает локальная заглушка.
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_API_URL=https://api.giga.chat/v1
# Вне Docker приложение .env не читает: ключ и сертификат передайте окружением (scripts/demo-up.sh делает это сам).
# NODE_EXTRA_CA_CERTS=deploy/certs/russian_trusted_root_ca.pem

# Хранилище знаний (Postgres + pgvector, схемы med и clinrec). Поднять: docker compose -f deploy/compose.dev.yml up -d knowledge-db
# затем: node scripts/knowledge_migrate.js. Пароль — свой, не коммитить.
KNOWLEDGE_DB_PASSWORD=
KNOWLEDGE_DB_PORT=54329
# KNOWLEDGE_DATABASE_URL=postgres://knowledge:CHANGE_ME@127.0.0.1:54329/knowledge
# KNOWLEDGE_DB_POOL_MAX=10
# KNOWLEDGE_DB_CONNECT_TIMEOUT_MS=5000
# KNOWLEDGE_DB_STATEMENT_TIMEOUT_MS=30000
# KNOWLEDGE_DB_SSL=1
# Приложение: пока KNOWLEDGE_DATABASE_URL пуст/не задан, знания о лекарствах выключены и всё работает как раньше.
# 1 = /readyz отдаёт 503 not_ready, если знания настроены, но недоступны или без векторов (по умолчанию readyz остаётся ready).
# KNOWLEDGE_REQUIRED=1
# Пауза (мс) без внешних эмбеддингов после сбоя GigaChat; поиск за это время идёт по lexical (по умолчанию 30000).
# KNOWLEDGE_EMBED_COOLDOWN_MS=30000
# Только для tests/regression/knowledge_pg_schema.test.js: тест ПЕРЕСОЗДАЁТ схемы med и clinrec в этой БД
# KNOWLEDGE_TEST_DATABASE_URL=postgres://knowledge:CHANGE_ME@127.0.0.1:54329/knowledge
# Резервные копии основной базы SQLite (задача планировщика): в DATA_DIR/backups, последние N штук, раз в сутки.
# 0 — выключено. В тестах (NODE_ENV=test) выключено по умолчанию.
# DB_BACKUP_KEEP=7
# DB_BACKUP_INTERVAL_HOURS=24
# DB_BACKUP_DIR=

# Пуши о напоминаниях (Web Push). PUSH_MODE: webpush | dry (без сети, только журнал) | off.
# Ключи VAPID: если не заданы, пара создаётся один раз в DATA_DIR/vapid.json. Для своей: npx web-push generate-vapid-keys
PUSH_MODE=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Дополнительные хосты служб доставки (через запятую), если пользователи используют нестандартный браузер
PUSH_ENDPOINT_HOSTS=
